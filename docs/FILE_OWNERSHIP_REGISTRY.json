  "protectionLevels": {
    "master": "Only A7 Sterling can commit changes. All others denied by pre-commit hook.",
    "expert": "A8 Reyes + A7 Sterling. Others denied by pre-commit hook.",
    "coordinator": "Hale (COS) + authorized coordinators. Others denied by pre-commit hook.",
    "curator": "A12 ELON. Others denied by pre-commit hook.",
    "editorial": "No direct file writes. Editorial pass via review process only (Naia, Dani).",
    "public": "All authors allowed. No protection."
  },
  "exceptions": {
    "archived": "Files in */archive/* or .archive/ directories exempt from protection (retired material)",
    "generated": "Files in output/*, logs/*, or data/* exempt from protection (auto-generated)",
    "dependencies": "Third-party dependencies in .venv/*, node_modules/*, or similar exempt",
    "drafts": "Files in drafts/* directory exempt (temporary working area)"
  },
