  "specialCases": {
    "dossiers": {
      "rule": "Dossier ownership is SPLIT by section type",
      "Sterling": "Client data, financial fields, booking references, dates",
      "Reyes": "Experience items (Excursion, Dining, Activity, Accessibility, Preferences)",
      "example": "dossiers/Kuklinski_Group_Viking.md can have Reyes-owned Excursion section AND Sterling-owned FPD section"
    },
    "missionBoard": {
      "rule": "Mission board task CREATION is ELON's; task STATE is Hale's",
      "ELON": "Creates/frames tasks (OpsCenter/elon_proposals/* for incubator)",
      "Hale": "Manages task state changes (OpsCenter/mission_board.json)",
      "remark": "ELON nominates; Hale executes state transitions"
    },
    "standingOrders": {
      "rule": "SO authorship varies; publication is Sterling's",
      "authors": "Various personas author SOs based on domain (e.g., A9 Harlan authors financial SOs)",
      "Sterling": "Owns publication, retirement, compliance audits",
      "remark": "Author writes SO content; Sterling publishes/retires"
    }
  },
  "violationProtocol": {
    "detection": "Pre-commit hook detects unauthorized commits",
    "errorMessage": "❌ [file]: [protection level] file owned by [owner]. Author '[author]' not authorized.",
    "resolution": [
      "1. REVERT changes (git checkout <file>)",
      "2. ROUTE to domain owner via PRODUCTION-LOCK ticket",
      "3. OBTAIN Commander override (one-time, named task only)"
    ],
    "escalation": {
      "first_violation": "Pre-commit hook blocks commit + clear error message",
      "repeat_violation": "Sterling → Commander brief on governance failure",
      "emergency_override": "Commander: 'Hale, execute [task] yourself.' (fires once)"
    }
  },
  "deployment": {
    "phase1": "2026-06-09 — Registry created, approved",
    "phase2": "2026-06-16 — Pre-commit hook deployed (warning mode)",
    "phase3": "2026-06-23 — Enforcement mode (hard reject)",
    "phase4": "2026-06-30+ — Optional Unix group-based permissions (Layer 2)"
  },
  "audit": {
    "frequency": "Weekly (Sterling, Sunday Baldrige sweep)",
    "command": "git log --since=1.week --name-only | xargs -I {} python3 hooks/file-permission-pre-commit.py --audit {}",
    "metric": "Unauthorized commits per week (target: 0)",
    "report": "Monthly summary in Baldrige metrics + morning brief"
  }
