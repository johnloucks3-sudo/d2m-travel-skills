{
  "name": "D2M — Claude to Google Drive Upload",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "drive-upload",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "d2m-drive-upload"
    },
    {
      "parameters": {
        "jsCode": "// Validate incoming payload\nconst body = $input.first().json.body;\n\nif (!body) {\n  throw new Error('No body received. Expected JSON payload.');\n}\n\n// Parse body if it came in as a string\nconst payload = typeof body === 'string' ? JSON.parse(body) : body;\n\n// Required fields\nconst required = ['filename', 'content'];\nfor (const field of required) {\n  if (!payload[field]) {\n    throw new Error(`Missing required field: ${field}`);\n  }\n}\n\n// Set defaults\nconst filename = payload.filename;\nconst content = payload.content;\nconst folderId = payload.folder_id || '1aVU22PPvcKMUFtyRDDpAYhqCvWTBohR7'; // Default: Kuklinski folder\nconst mimeType = payload.mime_type || 'text/markdown';\nconst description = payload.description || `Uploaded by D2M automation on ${new Date().toISOString()}`;\n\nreturn [{\n  json: {\n    filename,\n    content,\n    folderId,\n    mimeType,\n    description,\n    contentLength: content.length\n  }\n}];"
      },
      "id": "validate-payload",
      "name": "Validate & Parse Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "upload",
        "name": "={{ $json.filename }}",
        "driveId": {
          "__rl": true,
          "value": "My Drive",
          "mode": "list"
        },
        "folderId": {
          "__rl": true,
          "value": "={{ $json.folderId }}",
          "mode": "id"
        },
        "binaryPropertyName": "fileContent",
        "options": {
          "simplifyOutput": true
        }
      },
      "id": "google-drive-upload",
      "name": "Upload to Google Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [900, 300],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_GDRIVE_CREDENTIAL_ID",
          "name": "Google Drive — johnloucks3@gmail.com"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Convert text content to binary for Google Drive upload\nconst item = $input.first().json;\nconst content = item.content;\nconst filename = item.filename;\nconst mimeType = item.mimeType;\n\n// Encode content as base64 binary\nconst base64Content = Buffer.from(content, 'utf-8').toString('base64');\n\nreturn [{\n  json: item,\n  binary: {\n    fileContent: {\n      data: base64Content,\n      mimeType: mimeType,\n      fileName: filename,\n      fileExtension: filename.split('.').pop() || 'md'\n    }\n  }\n}];"
      },
      "id": "prepare-binary",
      "name": "Prepare Binary Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"success\",\n  \"message\": \"File uploaded to Google Drive\",\n  \"filename\": \"{{ $('Upload to Google Drive').item.json.name }}\",\n  \"file_id\": \"{{ $('Upload to Google Drive').item.json.id }}\",\n  \"drive_url\": \"https://drive.google.com/file/d/{{ $('Upload to Google Drive').item.json.id }}/view\",\n  \"folder_id\": \"{{ $('Validate & Parse Payload').item.json.folderId }}\",\n  \"uploaded_at\": \"{{ $now.toISO() }}\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "success-response",
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"error\",\n  \"message\": \"{{ $json.message }}\",\n  \"timestamp\": \"{{ $now.toISO() }}\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "error-response",
      "name": "Error Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1120, 420]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-upload-success",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-success",
      "name": "Upload Successful?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Validate & Parse Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate & Parse Payload": {
      "main": [
        [
          {
