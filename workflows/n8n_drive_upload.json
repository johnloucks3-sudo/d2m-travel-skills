            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Binary Data": {
      "main": [
        [
          {
            "node": "Upload to Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload to Google Drive": {
      "main": [
        [
          {
            "node": "Upload Successful?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload Successful?": {
      "main": [
        [
          {
            "node": "Success Response",
