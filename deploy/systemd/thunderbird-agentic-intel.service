[Unit]
Description=Thunderbird Nightly Agentic Intel Sweep (Hale COS)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/home/john/Thunderbird/.venv/bin/python /home/john/Thunderbird/core/intel/thunderbird_agentic_intel.py
WorkingDirectory=/home/john/Thunderbird
User=john
Environment=HOME=/home/john
Environment=PYTHONPATH=/home/john/Thunderbird
EnvironmentFile=/home/john/Thunderbird/.env

[Install]
WantedBy=multi-user.target
