[Unit]
Description=D2M Airline Route Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=john
WorkingDirectory=/home/john/Thunderbird
ExecStart=/home/john/bin/goose-d2m run --no-session --recipe /home/john/Thunderbird/recipes/airline_monitor.yaml
StandardOutput=append:/home/john/Thunderbird/logs/goose/airline_monitor.log
StandardError=append:/home/john/Thunderbird/logs/goose/airline_monitor.log
TimeoutStartSec=300
