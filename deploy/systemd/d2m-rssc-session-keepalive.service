[Unit]
Description=RSSC Regent Session Keepalive — Refresh cookies every 4h (Hale COS)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/home/john/Thunderbird/.venv/bin/python /home/john/Thunderbird/scripts/rssc_session_keepalive.py
WorkingDirectory=/home/john/Thunderbird
User=john
Environment=HOME=/home/john
Environment=PYTHONPATH=/home/john/Thunderbird
EnvironmentFile=/home/john/Thunderbird/.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rssc-session-keepalive
