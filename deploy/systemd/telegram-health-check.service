[Unit]
Description=Telegram Gateway Health Check
Documentation=https://github.com/d2m/thunderbird
After=network.target

[Service]
Type=oneshot
User=john
WorkingDirectory=/home/john/Thunderbird
Environment=PYTHONPATH=/home/john/Thunderbird
ExecStart=/home/john/Thunderbird/.venv/bin/python /home/john/Thunderbird/OpsCenter/telegram_health_check.py

# Logging
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target