[Unit]
Description=D2M X/Twitter OSINT Sweep
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=john
WorkingDirectory=/home/john/Thunderbird
ExecStart=/home/john/bin/goose-d2m run --no-session --recipe /home/john/Thunderbird/recipes/x_osint.yaml
StandardOutput=append:/home/john/Thunderbird/logs/goose/x_osint.log
StandardError=append:/home/john/Thunderbird/logs/goose/x_osint.log
TimeoutStartSec=300
