[Unit]
Description=D2M Operational Continuity Factbook (Claude Headless)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=john
WorkingDirectory=/home/john/Thunderbird
ExecStart=/usr/bin/python3 /home/john/Thunderbird/scripts/factbook_refresh.py
StandardOutput=append:/home/john/Thunderbird/logs/factbook_refresh.log
StandardError=append:/home/john/Thunderbird/logs/factbook_refresh.log
TimeoutStartSec=180
Environment="CLAUDE_CODE_OAUTH_TOKEN="
