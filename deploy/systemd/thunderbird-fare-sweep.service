[Unit]
Description=D2M Fare Watch Weekly Sweep
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=john
WorkingDirectory=/home/john/Thunderbird
EnvironmentFile=/home/john/Thunderbird/.env
ExecStart=/home/john/Thunderbird/.venv/bin/python3 /home/john/Thunderbird/agents/thunderbird_fare_sweep.py
StandardOutput=append:/home/john/Thunderbird/logs/fare_sweep.log
StandardError=append:/home/john/Thunderbird/logs/fare_sweep.log
TimeoutStartSec=120
