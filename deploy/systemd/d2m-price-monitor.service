[Unit]
Description=D2M Price Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=john
WorkingDirectory=/home/john/Thunderbird
ExecStart=/home/john/bin/goose-d2m run --no-session --recipe /home/john/Thunderbird/recipes/price_monitor.yaml
StandardOutput=append:/home/john/Thunderbird/logs/goose/price_monitor.log
StandardError=append:/home/john/Thunderbird/logs/goose/price_monitor.log
TimeoutStartSec=600
