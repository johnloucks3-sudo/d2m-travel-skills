[Unit]
Description=Perx Session Keepalive — Refresh TA rate cookies (Hale COS)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/home/john/Thunderbird/.venv/bin/python /home/john/Thunderbird/scripts/perx_session_keepalive.py
WorkingDirectory=/home/john/Thunderbird
User=john
Environment=HOME=/home/john
Environment=PYTHONPATH=/home/john/Thunderbird
EnvironmentFile=/home/john/Thunderbird/.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=perx-session-keepalive
