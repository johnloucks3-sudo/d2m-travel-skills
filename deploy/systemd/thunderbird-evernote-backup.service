[Unit]
Description=Thunderbird Evernote Weekly Backup
Requires=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/home/john/Thunderbird/.venv/bin/python /home/john/Thunderbird/api/thunderbird_evernote_backup.py
User=john
Environment=HOME=/home/john
Environment=PATH=/home/john/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=USER=john

[Install]
WantedBy=multi-user.target
