[Unit]
Description=Site Structure Sentinel — DOM change detection for supplier portals
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/home/john/Thunderbird/.venv/bin/python /home/john/Thunderbird/scripts/site_structure_sentinel.py
WorkingDirectory=/home/john/Thunderbird
User=john
Environment=HOME=/home/john
Environment=PYTHONPATH=/home/john/Thunderbird
EnvironmentFile=/home/john/Thunderbird/.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=site-sentinel
