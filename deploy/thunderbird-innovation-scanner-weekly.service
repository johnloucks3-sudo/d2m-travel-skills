[Unit]
Description=Thunderbird Innovation Scanner — Weekly Deep Scan (Sun 20:00 MT)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/home/john/Thunderbird/.venv/bin/python /home/john/Thunderbird/core/intel/thunderbird_innovation_scanner.py weekly
WorkingDirectory=/home/john/Thunderbird
User=john
Environment=HOME=/home/john
Environment=PYTHONPATH=/home/john/Thunderbird
EnvironmentFile=/home/john/Thunderbird/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
