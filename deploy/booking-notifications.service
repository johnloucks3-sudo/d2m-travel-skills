[Unit]
Description=D2M Booking Lifecycle Notification Scan (SMS/push/email-digest)
After=network.target

[Service]
Type=oneshot
User=john
WorkingDirectory=/home/john/Thunderbird
ExecStart=/home/john/Thunderbird/.venv/bin/python3 /home/john/Thunderbird/core/notifications/booking_notifications.py --scan
Environment=PYTHONPATH=/home/john/Thunderbird
StandardOutput=append:/home/john/Thunderbird/OpsCenter/logs/booking_notifications_service.log
StandardError=append:/home/john/Thunderbird/OpsCenter/logs/booking_notifications_service.log

[Install]
WantedBy=multi-user.target
