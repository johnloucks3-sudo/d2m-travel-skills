[Unit]
Description=Unified Router Health Daemon — Adapter Probe (5-min)
After=network.target

[Service]
Type=oneshot
User=john
WorkingDirectory=/home/john/Thunderbird
ExecStart=/home/john/Thunderbird/.venv/bin/python /home/john/Thunderbird/core/ai_infra/daemons/router_health_daemon.py --once
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
