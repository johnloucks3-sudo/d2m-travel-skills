    {
      "parameters": {
        "jsCode": "const data = $('Get Learning Digest').item.json;\nconst digest = data.digest || '';\nif (!digest || digest.includes('No corrections') || digest.includes('0 corrections')) return [];\nreturn [{ json: { message: `*Learning Compiler Digest*\\n${digest}` } }];"
      },
