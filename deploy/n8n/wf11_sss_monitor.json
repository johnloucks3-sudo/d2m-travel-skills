{
  "name": "D2M \u2014 Staff Summary Sheet Monitor",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */4 * * *"
            }
          ]
        }
      },
      "id": "wf11-0001-4000-8000-000000000001",
      "name": "Schedule \u2014 Every 4 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.d2mluxury.quest/api/sss/list?status=ready",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{$env.D2M_API_KEY}}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "wf11-0002-4000-8000-000000000002",
      "name": "SSS List \u2014 Pending Decisions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.item.json;\nconst data = r.data || r;\nconst items = data.items || data.results || data.pending || [];\nconst count = items.length;\nconst hasPending = count > 0;\n\nlet message = '';\nif (hasPending) {\n  const ts = new Date().toLocaleString('en-US', {timeZone: 'America/Denver', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit'});\n  const lines = items.slice(0,8).map(item => {\n    const age = item.age_hours ? ` (${item.age_hours}h old)` : '';\n    const from = item.from_persona || item.persona || item.author || '';\n    const fromStr = from ? ` \u2014 ${from}` : '';\n    return `\u2022 ${item.title || item.subject || item.id}${fromStr}${age}`;\n  });\n  message = `*D2M SSS \u2014 ${count} Item${count > 1 ? 's' : ''} Awaiting Decision \u2014 ${ts}*\\n\\n${lines.join('\\n')}`;\n  if (count > 8) message += `\\n_...and ${count - 8} more_`;\n}\n\nreturn [{ json: { hasPending, message, count } }];"
      },
      "id": "wf11-0003-4000-8000-000000000003",
      "name": "Check Pending Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.hasPending }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "wf11-0004-4000-8000-000000000004",
      "name": "Items Pending?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{$env.TELEGRAM_COMMANDER_ID}}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "wf11-0005-4000-8000-000000000005",
      "name": "Telegram \u2014 SSS Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1120,
        200
      ],
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "D2MC2C Bot"
        }
      }
    }
  ],
  "connections": {
    "Schedule \u2014 Every 4 Hours": {
