    {
      "parameters": {
        "jsCode": "const world = $('World Intel').item.json;\nconst ship = $('Ship Intel').item.json;\nconst ts = new Date().toLocaleString('en-US', {timeZone: 'America/Denver', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit'});\n\n// Extract from nested .data if present\nconst wData = world.data || world;\nconst sData = ship.data || ship;\n\n// World Intel \u2014 format stats + top alerts\nlet wText = '';\nif (wData.news_articles !== undefined) {\n  wText = `${wData.news_articles} articles \u00b7 ${wData.urgent_news || 0} urgent`;\n  if (wData.travel_advisories_total > 0) wText += ` \u00b7 ${wData.travel_advisories_total} advisories`;\n  if (wData.weather_alerts > 0) wText += ` \u00b7 ${wData.weather_alerts} weather alerts`;\n  const alerts = wData.top_alerts || [];\n  if (alerts.length) wText += '\\n' + alerts.slice(0,3).map(a => `\u2022 ${a}`).join('\\n');\n} else {\n  wText = wData.summary || wData.result || wData.message || JSON.stringify(wData).slice(0,500);\n}\n\n// Ship Intel \u2014 format stats\nlet sText = '';\nif (sData.voyages_scraped !== undefined) {\n  sText = `${sData.cruise_lines_monitored || 'Cruise lines'} \u00b7 ${sData.voyages_scraped} voyages \u00b7 ${sData.pricing_alerts || 0} price alerts \u00b7 ${sData.availability_alerts || 0} availability alerts`;\n} else {\n  sText = sData.summary || sData.result || sData.message || JSON.stringify(sData).slice(0,500);\n}\n\nconst msg = `*D2M Morning Brief \u2014 ${ts}*\\n\\n*World Intel*\\n${wText}\\n\\n*Ship Intel*\\n${sText}`;\nreturn [{ json: { message: msg } }];"
      },
