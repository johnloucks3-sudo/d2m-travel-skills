        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"query\": \"Review all dossiers in ~/Thunderbird/dossiers/. List every open action item, FPD deadline within 30 days, and overdue payment. Return a prioritized bullet list. Flag anything needing Commander action today.\", \"persona\": \"COS\"}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "d1b2c3d4-0002-4000-8000-000000000002",
      "name": "COS Dossier Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.item.json;\nconst text = r.response || r.result || r.answer || JSON.stringify(r);\nconst urgent = text.toLowerCase().includes('overdue') || text.toLowerCase().includes('today') || text.toLowerCase().includes('urgent');\nreturn [{ json: { text, urgent, hasContent: text.length > 50 } }];"
      },
      "id": "d1b2c3d4-0003-4000-8000-000000000003",
      "name": "Parse Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "7554895206",
        "text": "=\ud83d\udcc5 *D2M Deadline Monitor*{{ $json.urgent ? ' \u26a0\ufe0f ACTION REQUIRED' : '' }}\n\n{{ $json.text.slice(0, 3800) }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
