  }
  if (ship.pricing.signatureSuite) {
    pricingData.push(['Signature Suite', '$' + ship.pricing.signatureSuite.toLocaleString()]);
  }
  if (ship.pricing.medallionSuite) {
    pricingData.push(['Medallion Suite', '$' + ship.pricing.medallionSuite.toLocaleString()]);
