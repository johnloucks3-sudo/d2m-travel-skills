function compareShipsFromCells() {
  const sheet = SpreadsheetApp.getActiveSheet();
  const range = sheet.getSelection().getRange();

  // Get values from selected cells
  const values = range.getValues();

  if (values.length < 1 || values[0].length < 2) {
    SpreadsheetApp.getUi().alert('Please select at least 2 cells with ship names');
    return;
  }

  const ship1 = values[0][0]?.toString().trim();
  const ship2 = values[0][1]?.toString().trim();

  if (!ship1 || !ship2) {
    SpreadsheetApp.getUi().alert('Both cells must contain ship names');
    return;
  }

  if (!SHIP_DATABASE[ship1] || !SHIP_DATABASE[ship2]) {
    SpreadsheetApp.getUi().alert(`One or both ships not found in database:\n"${ship1}"\n"${ship2}"`);
    return;
  }

  generateShipComparison(ship1, ship2);
}

