// ========= Helper functions for comparison =========

function getShip1Emphasis(ship) {
  if (ship.specs.maxGuests < 250) return 'intimate expedition experiences';
  if (ship.ratios.spaceToGuest > 12) return 'spacious suites and personalization';
  return 'premium all-inclusive experiences';
}

function getShip2Emphasis(ship) {
  if (ship.specs.maxGuests > 750) return 'comprehensive onboard amenities';
  if (ship.amenities.spaSqFt > 8000) return 'world-class spa facilities';
  return 'balanced luxury and dining';
}

function getShip1BestFor(ship) {
  if (ship.specs.maxGuests < 250) return 'remote destination exploration';
  if (ship.ratios.spaceToGuest > 11) return 'space and privacy seekers';
  return 'all-inclusive luxury cruisers';
}

function getShip2BestFor(ship) {
  if (ship.specs.maxGuests > 750) return 'multiple dining/entertainment options';
  if (ship.amenities.spaSqFt > 8000) return 'spa and wellness enthusiasts';
  return 'curated luxury experiences';
}

function determineBestChoice(ship1, ship2) {
  const size1 = ship1.specs.maxGuests;
  const size2 = ship2.specs.maxGuests;

  if (size1 < size2) return `${ship1} for intimacy, ${ship2} for amenities`;
  return `${ship2} for intimacy, ${ship1} for amenities`;
}

