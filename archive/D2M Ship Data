    );
    reviewAttribution.setFontSize(10);
    reviewAttribution.setForegroundColor('#666666');

    docBody.appendParagraph('');
  }

  // KEY ADVANTAGES
  const advHeading = docBody.appendParagraph('KEY ADVANTAGES');
  advHeading.setHeading(DocumentApp.ParagraphHeading.HEADING2);
  advHeading.setForegroundColor('#1f4788');

  for (const adv of ship.advantages) {
    docBody.appendParagraph(`✓ ${adv}`);
  }

  docBody.appendParagraph('');

  // CONSIDERATIONS
  const consHeading = docBody.appendParagraph('IMPORTANT CONSIDERATIONS');
  consHeading.setHeading(DocumentApp.ParagraphHeading.HEADING2);
  consHeading.setForegroundColor('#1f4788');

  for (const con of ship.considerations) {
    docBody.appendParagraph(`• ${con}`);
  }

  docBody.appendParagraph('');

  // BEST FOR
  const bestHeading = docBody.appendParagraph('IDEAL PASSENGERS');
  bestHeading.setHeading(DocumentApp.ParagraphHeading.HEADING2);
  bestHeading.setForegroundColor('#1f4788');
  docBody.appendParagraph(`${shipName} is particularly well-suited for:`);

