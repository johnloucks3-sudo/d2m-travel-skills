  docBody.appendParagraph('');

  // FINAL SUMMARY
  const finalHeading = docBody.appendParagraph('CONCLUSION');
  finalHeading.setHeading(DocumentApp.ParagraphHeading.HEADING2);
  finalHeading.setForegroundColor('#1f4788');

  const conclusion = docBody.appendParagraph(
    `${shipName} represents ${ship.line}'s commitment to luxury cruising with exceptional ` +
    `service ratios, premium amenities, and curated itineraries. The ship's ${ship.amenities.designFeature.toLowerCase()} ` +
    `ensures a distinctive experience. Whether seeking intimate exploration or ` +
    `grand Mediterranean discovery, ${shipName} delivers all-inclusive excellence.`
  );
  conclusion.setFontSize(12);

  docBody.appendParagraph('');

  // Footer
  const footer = docBody.appendParagraph(
    `Report generated by Dreams2Memories Travel\n` +
    `For more information, visit info@dreams2memories.com`
  );
  footer.setFontSize(10);
  footer.setForegroundColor('#999999');
  footer.setItalic(true);
}

