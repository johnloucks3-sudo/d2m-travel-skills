    docBody.appendParagraph(`Departure: ${voyage.departure}`);
    docBody.appendParagraph(`Duration: ${voyage.duration} days`);
    docBody.appendParagraph(`Route: ${voyage.ports}`);
    docBody.appendParagraph(`Price: ${voyage.price}`);
    docBody.appendParagraph(`Availability: ${voyage.availability}`);
    docBody.appendParagraph(`Status: ${voyage.status}`);
    docBody.appendParagraph(`Highlights: ${voyage.highlights}`);

    const linkParagraph = docBody.appendParagraph(`Learn More: ${voyage.link}`);
    linkParagraph.setFontSize(10);
    linkParagraph.setForegroundColor('#0563C1');

    docBody.appendParagraph('');
  }

  // CLIENT REVIEWS
  const reviewsHeading = docBody.appendParagraph('CLIENT REVIEWS & TESTIMONIALS');
  reviewsHeading.setHeading(DocumentApp.ParagraphHeading.HEADING2);
  reviewsHeading.setForegroundColor('#1f4788');

  for (const review of ship.reviews) {
    const reviewQuote = docBody.appendParagraph(`"${review.quote}"`);
    reviewQuote.setItalic(true);
    reviewQuote.setFontSize(11);

    const reviewAttribution = docBody.appendParagraph(
