  docBody.appendParagraph('');

  // UPCOMING VOYAGES
  const voyagesHeading = docBody.appendParagraph('UPCOMING VOYAGES (2025-2026)');
  voyagesHeading.setHeading(DocumentApp.ParagraphHeading.HEADING2);
  voyagesHeading.setForegroundColor('#1f4788');

  for (const voyage of ship.voyages) {
    const voyageTitle = docBody.appendParagraph(`${voyage.name}`);
