  // Trigger: "Ship Intel [Ship Name]"
  if (lower.match(/^ship intel\s+(.+)/i)) {
    const shipName = lower.replace('ship intel ', '').trim();
    // Routes to the analysis engine in D2M_Ship_Compare.gs
    return generateShipAnalysis(shipName);
  }

  // 4. CRUISE LINE & ENTITY RESEARCH
  if (lower.match(/^line intel\s+(.+)/i)) return generateLineDossier(lower.replace('line intel ', ''));
  if (lower.match(/research\s+(.+)/i)) return researchEntity(lower.replace('research ', ''));

  // 5. MARKET & COMPETITIVE INTELLIGENCE
  if (lower.match(/competitor|competitive/)) return generateCompetitorAnalysis();
  if (lower.match(/promo|promotion/)) return scanPromotions();
  if (lower.match(/new build|new ship/)) return trackNewBuilds();

  // DEFAULT FALLBACK
  return "❌ COMMAND REJECTED: Directive not recognized.";
}

