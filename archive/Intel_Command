// 5. NEWS, PARSING & CLASSIFICATION HELPERS
// ═══════════════════════════════════════════════════════════════════════════════
function searchNews(query, max = 10) {
  try {
    const url = `https://news.google.com/rss/search?q=${encodeURIComponent(query)}&hl=en-US&gl=US&ceid=US:en`;
    const res = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
    if (res.getResponseCode() !== 200) return [];
    return parseRSSFeed(res.getContentText()).slice(0, max);
  } catch (e) { return []; }
}

function searchTradeNews(query, maxResults = 5) {
  const results = [];
  for (const source of INTEL_SOURCES.trade.slice(0, 3)) {
    try {
      const url = `${source.baseUrl}${encodeURIComponent(query)}&hl=en-US&gl=US&ceid=US:en`;
      const response = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
      if (response.getResponseCode() === 200) {
        const parsed = parseRSSFeed(response.getContentText());
        parsed.forEach(item => { item.source = source.name; item.authority = source.authority; });
        results.push(...parsed.slice(0, 2));
      }
      Utilities.sleep(500);
    } catch (e) { console.log(`Trade search error (${source.name}): ${e.message}`); }
  }
  return results.slice(0, maxResults);
}

function parseRSSFeed(xml) {
  const results = [];
  try {
    const channel = XmlService.parse(xml).getRootElement().getChild('channel');
    if (!channel) return results;

    for (const item of channel.getChildren('item')) {
      const title = item.getChildText('title') || '';
      results.push({
        title: cleanHeadline(title),
        link: item.getChildText('link') || '',
        pubDate: item.getChildText('pubDate') || '',
        source: extractSource(title)
      });
    }
  } catch (e) { console.log('RSS parse error: ' + e.message); }
  return results;
}

function cleanHeadline(title) { return title.replace(/ - [^-]+$/, '').trim(); }
function extractSource(title) { const match = title.match(/ - ([^-]+)$/); return match ? match[1].trim() : 'Unknown'; }

function classifyHeadline(headline) {
  const lower = headline.toLowerCase();
  for (const [category, keywords] of Object.entries(INTEL_SOURCES.categories)) {
    if (keywords.some(kw => lower.includes(kw))) return category;
  }
  return 'GENERAL';
}

function calculatePriority(newsItem, config, category) {
  let score = 0;
  if (config.tier === 'ultra-luxury') score += 3;
  if (config.tier === 'premium') score += 2;
  if (config.priority === 1) score += 2;
  if (config.priority === 2) score += 1;
  if (category === 'PROMOTION') score += 2;
  if (category === 'NEW_BUILD' || category === 'INCIDENT') score += 3;
  if (config.ships.some(s => (s.status === 'new-build' || s.status === 'ordered') && newsItem.title.toLowerCase().includes(s.name.toLowerCase()))) score += 2;
  if (INTEL_SOURCES.promoKeywords.some(kw => newsItem.title.toLowerCase().includes(kw))) score += 2;

  return score >= 6 ? 'HIGH' : score >= 3 ? 'MEDIUM' : 'LOW';
}

function detectShipMention(headline, ships) {
  const lower = headline.toLowerCase();
  for (const ship of ships) { if (lower.includes(ship.name.toLowerCase())) return ship.name; }
  return null;
}

function getTimeGreeting() {
  const hour = new Date().getHours();
  if (hour < 12) return 'Good morning, Commander.';
  if (hour < 17) return 'Good afternoon, Commander.';
  return 'Good evening, Commander.';
}

function getCategoryIcon(category) {
  const icons = { 'PROMOTION': '💰', 'NEW_BUILD': '🚢', 'DEPLOYMENT': '🗺️', 'EXECUTIVE': '👔', 'REFURB': '🔧', 'INCIDENT': '⚠️', 'AWARD': '🏆', 'PARTNERSHIP': '🤝', 'FINANCIAL': '📈', 'GENERAL': '○' };
  return icons[category] || '○';
}

function formatStatus(status) {
  const statusMap = { 'active': '✅ Active Service', 'new-build': '🔨 Under Construction', 'ordered': '📋 On Order', 'expedition': '🧊 Expedition Service', 'river': '🏞️ River Service', 'ocean': '🌊 Ocean Service' };
  return statusMap[status] || status;
}

function truncate(str, length) {
  if (!str) return '';
  return str.length <= length ? str : str.substring(0, length - 3) + '...';
}

