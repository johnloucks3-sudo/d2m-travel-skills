function logIntelItem(sheet, item) {
  const lastRow = sheet.getLastRow();
  if (lastRow > 1) {
    const checkRows = Math.min(100, lastRow - 1);
    const existingHeadlines = sheet.getRange(lastRow - checkRows + 1, 5, checkRows, 1).getValues().flat();
    if (existingHeadlines.includes(item.headline)) return false;
  }
  sheet.appendRow([new Date(), item.source, item.line, item.ship || '', item.headline, item.category, item.priority, item.url, false]);
  return true;
}

function formatSweepReport(report, duration) {
  let output = `╔══════════════════════════════════════════════════════════════════════════════╗\n║  🕵️ INTEL SWEEP COMPLETE                                                     ║\n╚══════════════════════════════════════════════════════════════════════════════╝\n\n  Timestamp:    ${report.timestamp.toLocaleString()}\n  Duration:     ${duration.toFixed(1)} seconds\n  Items Found:  ${report.itemsFound}\n\n`;

  if (report.highPriority.length > 0) {
    output += `┌──────────────────────────────────────────────────────────────────────────────┐\n│  🔴 HIGH PRIORITY ITEMS                                                      │\n└──────────────────────────────────────────────────────────────────────────────┘\n\n`;
    report.highPriority.slice(0, 5).forEach(item => {
      output += `  • ${truncate(item.headline, 70)}\n    └─ ${item.line}\n\n`;
    });
  }

  output += `┌──────────────────────────────────────────────────────────────────────────────┐\n│  BY CATEGORY                                                                 │\n└──────────────────────────────────────────────────────────────────────────────┘\n\n`;
  for (const [category, items] of Object.entries(report.byCategory || {})) {
    output += `  ${getCategoryIcon(category)} ${category}: ${items.length} items\n`;
  }
  return output;
}

function getOrCreateSheet(ss, name, headers) {
  let sheet = ss.getSheetByName(name);
  if (!sheet) {
    sheet = ss.insertSheet(name);
    if (headers) {
      sheet.appendRow(headers);
      sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold').setBackground('#4a86e8').setFontColor('white');
      sheet.setFrozenRows(1);
    }
  }
  return sheet;
}
