  "voice": {
    "tone_descriptors": [
      "warm",
      "literate",
      "visually precise",
      "never corporate",
      "never generic",
      "human first"
    ],
    "register": "semi-formal",
    "primary_tone": "professional",
    "secondary_tones": ["helpful", "friendly", "excited"],
    "sentence_style": "medium-length, conversational-professional",
    "prohibited_punctuation": ["em-dash", "ellipsis"],
