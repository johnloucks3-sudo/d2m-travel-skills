    "signoff_required": "Thanks,\nJohn",
    "signoff_never_use": ["Best,", "Warm regards,", "Sincerely,", "Best regards,", "Kind regards,"],
    "favorite_phrases": ["going to be", "looking forward to", "make sure"],
    "use_bold_for_emphasis": true,
    "include_specific_details_and_dates": true,
    "paragraph_length": "2-5 sentences",
    "exclamation_points": "occasional — for genuine enthusiasm only"
  },

  "banned_phrases": [
    "Love Group Travel",
    "likely",
    "probably",
    "approximately",
    "pending confirmation",
    "I believe",
    "please don't hesitate",
    "happy to help",
    "as per your request",
    "touch base",
    "circle back",
    "going forward",
    "leverage",
    "utilize",
    "synergy",
    "seamless",
    "curated",
    "bespoke",
    "world-class",
    "best-in-class",
    "exciting opportunity",
    "consider it done",
    "standing by"
  ],

  "client_email_standards": {
    "stationery": {
      "background": "#f7f3ea",
      "text_color": "#0000ff",
      "accent": "#003087",
      "font": "Georgia",
      "banner_color": "#003087",
      "requires_logo_banner": true
    },
    "opening": "Personal/relational paragraph required — Wing writes complete email, Commander adds nothing",
    "ai_aware_clients": "John personal preface block before Dani block (see Kuklinski AI disclosure precedent)",
    "prohibit_upsell_in_routine_replies": true,
    "prohibit_generic_filler": true,
    "prohibit_canned_responses": true
  },

  "brand_voice_checklist": [
    "Zero instances of 'Love Group Travel' or other prohibited company name variants",
    "USAFA colors (#f7f3ea / #0000ff / #003087) present in HTML products",
    "Warm but not effusive — never sycophantic",
    "Specific and concrete — no vague assurances",
    "Personal opening paragraph present in all client emails",
    "Sign-off: 'Thanks, John' — never 'Best'",
    "No placeholder text ([INSERT], [TBD], [DRAFT]) remaining",
    "No AI language or corporate jargon",
    "No banned phrases from banned_phrases list",
    "Emotional register matches client relationship depth",
    "Client name correctly spelled and used",
    "D2M logo present on client-facing products"
  ],

  "quality_gate": {
    "brand_voice_score_minimum": 7,
    "scale": "0-10",
    "auto_fail_conditions": [
      "company_name_violation",
      "banned_phrase_in_client_position",
      "love_group_travel_present",
      "wrong_signoff"
    ],
    "soft_block_conditions": [
