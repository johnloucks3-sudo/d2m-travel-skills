[Unit]
Description=D2M Commission Reconciliation — Monthly (TESS + OA + Manual vs Booking Master)
After=network.target
Documentation=file:///home/john/Thunderbird/scripts/commission_reconciliation_monthly.py

[Service]
Type=oneshot
WorkingDirectory=/home/john/Thunderbird
ExecStart=/home/john/Thunderbird/.venv/bin/python3 /home/john/Thunderbird/scripts/commission_reconciliation_monthly.py
StandardOutput=append:/home/john/Thunderbird/OpsCenter/logs/commission_reconciliation_monthly.log
StandardError=append:/home/john/Thunderbird/OpsCenter/logs/commission_reconciliation_monthly.log
Environment="PYTHONPATH=/home/john/Thunderbird"
Restart=on-failure

[Install]
WantedBy=default.target
