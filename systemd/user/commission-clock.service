[Unit]
Description=D2M Commission Clock — Weekly Harlan 6-Step Verification
After=network.target
Documentation=file:///home/john/Thunderbird/scripts/commission_clock.py

[Service]
Type=oneshot
WorkingDirectory=/home/john/Thunderbird
ExecStart=/home/john/Thunderbird/.venv/bin/python3 /home/john/Thunderbird/scripts/commission_clock.py
StandardOutput=append:/home/john/Thunderbird/OpsCenter/logs/commission_clock.log
StandardError=append:/home/john/Thunderbird/OpsCenter/logs/commission_clock.log
Environment="PYTHONPATH=/home/john/Thunderbird"
Restart=on-failure

[Install]
WantedBy=default.target
