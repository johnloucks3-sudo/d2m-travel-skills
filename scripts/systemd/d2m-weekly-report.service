[Unit]
Description=D2M Weekly Activity Report Generator
After=network.target

[Service]
Type=oneshot
User=john
WorkingDirectory=/home/john/Thunderbird
ExecStart=/home/john/Thunderbird/.venv/bin/python3 /home/john/Thunderbird/scripts/generate_weekly_report.py
StandardOutput=append:/home/john/Thunderbird/logs/weekly_report.log
StandardError=append:/home/john/Thunderbird/logs/weekly_report.log
Environment="PYTHONPATH=/home/john/Thunderbird"
Environment="HOME=/home/john"
Environment="PATH=/home/john/.local/bin:/usr/local/bin:/usr/bin:/bin"
UnsetEnvironment=ANTHROPIC_API_KEY
UnsetEnvironment=ANTHROPIC_BASE_URL
