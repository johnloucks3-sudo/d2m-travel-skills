[Unit]
Description=D2M Centrav Session Warm-Ping (MISSION-200) — keeps B2B flight portal session alive (non-destructive)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/john/Thunderbird
ExecStart=/home/john/Thunderbird/.venv/bin/python /home/john/Thunderbird/scripts/centrav_session_warm.py
# Safe-skip exit codes are NOT failures: 2=dead session (needs manual login), 3=skipped (profile locked).
SuccessExitStatus=0 2 3
StandardOutput=append:/home/john/Thunderbird/logs/centrav_warm.log
StandardError=append:/home/john/Thunderbird/logs/centrav_warm.log

[Install]
WantedBy=default.target
