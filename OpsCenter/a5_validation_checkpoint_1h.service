[Unit]
Description=A5 Validation 1-Hour Checkpoint Alert
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'echo "ALARM: A5 CASTILLO 1-HOUR CHECKPOINT DUE (15:50 MT)" | tee -a /home/john/Thunderbird/logs/a5_validation_alerts.log'
ExecStart=/bin/bash -c 'test -f /home/john/Thunderbird/escalations/A5_VALIDATION_TASK_20260514.md && echo "Validation task file found. Check for A5 status update." || echo "WARNING: Task file missing"'
StandardOutput=journal
StandardError=journal
