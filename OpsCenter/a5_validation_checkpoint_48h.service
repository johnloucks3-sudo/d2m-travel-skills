[Unit]
Description=A5 Validation FINAL Report Checkpoint Alert
After=network.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'echo "ALARM: A5 CASTILLO FINAL VALIDATION REPORT DUE (14:50 MT, May 16)" | tee -a /home/john/Thunderbird/logs/a5_validation_alerts.log'
ExecStart=/bin/bash -c 'test -f /home/john/Thunderbird/escalations/A5_VALIDATION_TASK_20260514.md && echo "DECISION GATE: Check for PASS/FAIL verdict. Present result to Commander immediately." || echo "WARNING: Task file missing"'
StandardOutput=journal
StandardError=journal
