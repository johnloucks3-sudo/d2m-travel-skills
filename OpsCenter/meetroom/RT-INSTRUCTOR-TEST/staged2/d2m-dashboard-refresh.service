[Unit]
Description=D2M Dashboard Refresh — ETB-006
After=network.target
Documentation=file:///home/john/Thunderbird/OpsCenter/dashboard_generator.py
OnFailure=thunderbird-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/home/john/Thunderbird
ExecStart=/home/john/Thunderbird/.venv/bin/python3 /home/john/Thunderbird/OpsCenter/dashboard_generator.py --once
StandardOutput=append:/home/john/Thunderbird/OpsCenter/logs/dashboard_generator.log
StandardError=append:/home/john/Thunderbird/OpsCenter/logs/dashboard_generator.log
Environment="PYTHONPATH=/home/john/Thunderbird"

[Install]
WantedBy=default.target