[Unit]
Description=OpenCode SPSA Case Monitor
Wants=network.target
OnFailure=thunderbird-alert@%n.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/john/Thunderbird/OpsCenter/opencode_spsa_monitor.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
WorkingDirectory=/home/john/Thunderbird

[Install]
WantedBy=default.target