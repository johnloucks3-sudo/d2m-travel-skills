[Unit]
Description=D2M Lifecycle Email Scheduler — ETB-003
After=network.target
Documentation=file:///home/john/Thunderbird/core/lifecycle/lifecycle_scheduler.py

[Service]
Type=oneshot
WorkingDirectory=/home/john/Thunderbird
ExecStart=/home/john/Thunderbird/.venv/bin/python3 /home/john/Thunderbird/core/lifecycle/lifecycle_scheduler.py
StandardOutput=append:/home/john/Thunderbird/OpsCenter/logs/lifecycle_scheduler.log
StandardError=append:/home/john/Thunderbird/OpsCenter/logs/lifecycle_scheduler.log
Environment="PYTHONPATH=/home/john/Thunderbird"

[Install]
WantedBy=default.target
