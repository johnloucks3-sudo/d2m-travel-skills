[Unit]
Description=Hale Brain Synchronization Monitor Timer (Every 12 Hours)
Requires=hale_brain_monitor.service

[Timer]
# Run at 06:00 AM and 18:00 PM (6 AM and 6 PM) Mountain Time
OnCalendar=*-*-* 06:00:00
OnCalendar=*-*-* 18:00:00

# If system was off at scheduled time, run within 5 min of startup
Persistent=true

# Set timezone to Mountain Time
Timezone=America/Denver

# Randomize by 30 seconds to avoid thundering herd
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
