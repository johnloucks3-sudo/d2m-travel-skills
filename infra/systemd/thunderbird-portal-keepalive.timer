[Unit]
Description=Thunderbird Portal Session Keepalive Timer
Documentation=file:///home/john/Thunderbird/docs/PORTAL_COOKIE_REFRESH_MANUAL_SOP.md

[Timer]
# Run at 00:00, 06:00, 12:00, 18:00 UTC (every 6 hours)
OnCalendar=*-*-* 00,06,12,18:00:00 UTC

# Also run 15 minutes after system boot (time for network to stabilize)
OnBootSec=15min

# If a run is missed, run it as soon as possible when system wakes
Persistent=true

# Randomize start by 0-5 minutes to avoid thundering herd
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
