<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ cover.client_name }} — {{ cover.voyage_name }} Memory Book</title>
  <style>
    {% include "d2m_base.css.j2" %}

    body { background: var(--navy); }
    .hero {
      text-align: center;
      padding: 64px 24px 40px 24px;
      background: linear-gradient(180deg, var(--navy2) 0%, var(--navy) 100%);
    }
    .hero .kicker { font-size: 12px; letter-spacing: 4px; color: var(--gold); text-transform: uppercase; margin-bottom: 20px; }
    .hero h1 { font-size: 34px; margin-bottom: 6px; }
    .hero .ship { font-size: 17px; color: var(--gold-light); margin-bottom: 4px; }
    .hero .dates { font-size: 13px; color: var(--muted); }

    .section { max-width: 1100px; margin: 0 auto; padding: 32px 24px; }
    .section-title { font-size: 20px; color: var(--gold); border-bottom: 1px solid var(--navy3); padding-bottom: 8px; margin-bottom: 16px; }
    .section-note { font-size: 13px; color: var(--text-light); margin-bottom: 16px; font-style: italic; }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 12px;
    }
    .grid a { display: block; text-decoration: none; }
    .grid img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 6px;
      border: 1px solid var(--navy3);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .grid a:hover img { transform: scale(1.03); box-shadow: 0 6px 18px rgba(0,0,0,0.4); }
    .cap { font-size: 11px; color: var(--muted); margin-top: 4px; text-align: center; }

    /* CSS-only lightbox — no JS required, works via #anchor targeting */
    .lightbox {
      display: none;
      position: fixed; inset: 0;
      background: rgba(2,2,20,0.92);
      z-index: 50;
      align-items: center; justify-content: center;
      flex-direction: column;
    }
    .lightbox:target { display: flex; }
    .lightbox img { max-width: 90vw; max-height: 82vh; border-radius: 6px; box-shadow: 0 12px 40px rgba(0,0,0,0.6); }
    .lightbox .cap { color: var(--text-light); margin-top: 16px; font-size: 14px; }
    .lightbox .close {
      position: absolute; top: 24px; right: 32px;
      color: var(--gold-light); font-size: 28px; text-decoration: none;
    }

    .closing { text-align: center; padding: 60px 40px 90px 40px; }
    .closing p { font-size: 17px; color: var(--gold-light); line-height: 1.9; }
  </style>
</head>
<body>

  <div class="hero">
    <div class="kicker">Dreams2Memories Travel · Voyage Memory Book</div>
    <h1>{{ cover.client_name }}</h1>
    <div class="ship">{{ cover.ship_name }} &middot; {{ cover.voyage_name }}</div>
    <div class="dates">{{ cover.voyage_dates }}</div>
  </div>

  {% for pg in pages %}
  <div class="section">
    <div class="section-title">{{ pg.section_title }}</div>
    {% if pg.note %}<div class="section-note">{{ pg.note }}</div>{% endif %}
    <div class="grid">
      {% for photo in pg.photos %}
      <a href="#photo-{{ loop.index0 }}-{{ loop.index }}">
        <img src="{{ photo.data_uri }}" alt="{{ photo.caption }}">
        {% if photo.caption %}<div class="cap">{{ photo.caption }}</div>{% endif %}
      </a>
      {% endfor %}
    </div>
  </div>
  {% for photo in pg.photos %}
  <div class="lightbox" id="photo-{{ loop.index0 }}-{{ loop.index }}">
    <a href="#" class="close">&times;</a>
    <img src="{{ photo.data_uri }}" alt="{{ photo.caption }}">
    {% if photo.caption %}<div class="cap">{{ photo.caption }}</div>{% endif %}
  </div>
  {% endfor %}
  {% endfor %}

  <div class="closing">
    <p>{{ closing_note }}</p>
  </div>

</body>
</html>
