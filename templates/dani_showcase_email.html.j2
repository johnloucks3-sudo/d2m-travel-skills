<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ subject }}</title>
<style>
  body, table, td, p, a { margin: 0; padding: 0; }
  body { font-family: 'Georgia', 'Times New Roman', serif; background-color: #eee8db; color: #0000ff; line-height: 1.7; }
  .wrapper { max-width: 640px; margin: 0 auto; background: #ffffff; }
  .header { background: #0d1b2e; padding: 36px 40px 28px 40px; text-align: center; }
  .header .tagline { font-family: 'Georgia', serif; font-size: 11px; color: #f5e9c8; letter-spacing: 2.5px; font-style: italic; margin-top: 10px; }
  .gold-line { height: 2px; background: linear-gradient(90deg, #0d1b2e 5%, #c9a84c 30%, #c9a84c 70%, #0d1b2e 95%); }
  .hero-area { width: 100%; height: 160px; background: linear-gradient(135deg, #0d1b2e 0%, #1e3358 30%, #2a5a6a 60%, #4a8a7a 80%, #8ab4a0 100%); text-align: center; line-height: 160px; }
  .hero-text { font-family: 'Georgia', serif; font-size: 16px; color: #c9a84c; letter-spacing: 4px; text-transform: uppercase; }
  .content { padding: 36px 40px; }
  .body-text { font-size: 15px; color: #2a2a2a; margin-bottom: 16px; line-height: 1.7; }
  .body-text em { color: #0d1b2e; font-style: italic; }
  .punchline { font-size: 18px; color: #0d1b2e; font-weight: bold; margin: 16px 0 20px 0; font-family: 'Georgia', serif; }
  .section-divider { text-align: center; margin: 32px 0 16px 0; }
  .section-divider span { display: inline-block; font-size: 13px; font-family: 'Georgia', serif; font-weight: bold; color: #c9a84c; letter-spacing: 2px; text-transform: uppercase; }
  .section-divider::before, .section-divider::after { content: ""; display: inline-block; width: 60px; height: 1px; background: #e8d9b8; vertical-align: middle; margin: 0 12px; }
  .note-box { background: #f9f7f3; border: 1px solid #e8e0d0; border-radius: 4px; padding: 18px 22px; margin-bottom: 24px; }
  .note-label { font-size: 14px; color: #0d1b2e; font-weight: bold; margin-bottom: 8px; }
  .note-text { font-size: 14px; color: #2a2a2a; line-height: 1.6; }

  /* John's signature handoff */
  .john-sign-off { font-family: 'Georgia', serif; font-size: 15px; color: #0d1b2e; font-style: italic; margin: 20px 0 8px 0; }

  /* Voice transition */
  .voice-transition { text-align: center; margin: 36px 0 28px 0; position: relative; }
  .voice-transition::before { content: ""; display: block; width: 100%; height: 1px; background: linear-gradient(90deg, #ffffff 0%, #c9a84c 30%, #c9a84c 70%, #ffffff 100%); margin-bottom: 14px; }
  .voice-transition::after { content: ""; display: block; width: 100%; height: 1px; background: linear-gradient(90deg, #ffffff 0%, #c9a84c 30%, #c9a84c 70%, #ffffff 100%); margin-top: 14px; }
  .voice-transition-label { font-size: 11px; color: #c9a84c; letter-spacing: 2px; text-transform: uppercase; font-family: 'Georgia', serif; }

  /* Dani's intro greeting */
  .dani-greeting { font-size: 15px; color: #2a4a5a; font-style: italic; line-height: 1.7; margin-bottom: 20px; padding: 14px 20px; background: #f6f9fa; border-left: 3px solid #2a4a5a; border-radius: 0 4px 4px 0; }

  /* Dani's sections — subtle visual differentiation */
  .dani-section { border-left: 3px solid #2a4a5a; padding-left: 20px; margin-left: 0; }
  .dani-section .body-text { color: #2a3a4a; }
  .dani-section .body-text em { color: #1a2a3a; }
  .dani-section .section-divider span { color: #2a4a5a; }

  /* Staff roster table */
  .staff-table { width: 100%; border-collapse: collapse; margin: 16px 0 20px 0; font-size: 13px; }
  .staff-table th { background: #152540; color: #c9a84c; font-size: 11px; letter-spacing: 1px; text-transform: uppercase; padding: 10px 10px; text-align: left; font-weight: normal; }
  .staff-table td { padding: 8px 10px; border-bottom: 1px solid #f0ebe3; color: #2a2a2a; vertical-align: top; }
  .staff-table tr:nth-child(even) td { background: #faf8f4; }
  .staff-table .role-name { color: #0d1b2e; font-weight: bold; white-space: nowrap; }
  .staff-table .person-name { color: #c9a84c; font-weight: bold; white-space: nowrap; }

  /* Phase block */
  .phase-block { margin: 16px 0; padding: 16px 20px; background: #f6f9fa; border-left: 3px solid #2a4a5a; border-radius: 0 4px 4px 0; }
  .phase-title { font-family: 'Georgia', serif; font-size: 15px; color: #1a2a3a; font-weight: bold; margin-bottom: 6px; }
  .phase-text { font-size: 14px; color: #2a3a4a; line-height: 1.6; }
  .phase-text em { font-style: italic; color: #1a2a3a; }

  /* Teaser */
  .teaser { font-size: 15px; color: #5a6a85; font-style: italic; margin: 12px 0 20px 0; line-height: 1.6; text-align: center; }
  .teaser em { color: #0d1b2e; }

  /* Mission quote */
  .mission-quote { background: #0d1b2e; border-left: 4px solid #c9a84c; padding: 22px 26px; margin: 20px 0; border-radius: 0 4px 4px 0; }
  .mission-quote p { font-family: 'Georgia', serif; font-size: 15px; color: #e8c97a; line-height: 1.7; font-style: italic; }

  /* Mission closer */
  .mission-closer { font-family: 'Georgia', serif; font-size: 17px; color: #0d1b2e; text-align: center; margin: 24px 0; font-style: italic; }

  /* Attachment box */
  .attachment-box { background: #0d1b2e; padding: 24px 28px; margin: 28px 0; border-radius: 4px; text-align: center; }
  .attachment-label { font-family: 'Georgia', serif; font-size: 13px; color: #c9a84c; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 10px; }
  .attachment-intro { font-size: 13px; color: #8a9ab5; font-style: italic; line-height: 1.6; margin-bottom: 14px; }
  .attachment-route { font-family: 'Georgia', serif; font-size: 14px; color: #e8c97a; line-height: 1.5; }
  .attachment-stats { font-size: 13px; color: #c9a84c; letter-spacing: 1px; margin-top: 8px; font-weight: bold; }

  /* CTA */
  .cta-box { background: linear-gradient(135deg, #0d1b2e 0%, #1e3358 100%); border: 2px solid #c9a84c; border-radius: 6px; padding: 28px 30px; margin: 30px 0; text-align: center; }
  .cta-title { font-family: 'Georgia', serif; font-size: 18px; color: #c9a84c; margin-bottom: 12px; }
  .cta-text { font-size: 14px; color: #d0d8e8; line-height: 1.7; margin-bottom: 16px; }
  .cta-referral { font-size: 13px; color: #8a9ab5; font-style: italic; line-height: 1.6; margin-top: 12px; }
  .cta-contact { font-size: 15px; color: #e8c97a; font-weight: bold; }
  .cta-contact a { color: #e8c97a; text-decoration: none; }

  /* Signature */
  .sig-divider { width: 60px; height: 1px; background: #c9a84c; margin: 28px 0 20px 0; }
  .sig-name { font-family: 'Georgia', serif; font-size: 17px; color: #0d1b2e; font-weight: bold; }
  .sig-title { font-size: 12px; color: #c9a84c; letter-spacing: 1.5px; text-transform: uppercase; font-style: italic; margin-top: 2px; }
  .sig-company { font-size: 12px; color: #8a9ab5; letter-spacing: 1px; margin-top: 2px; }
  .sig-contact { font-size: 12px; color: #2a2a2a; margin-top: 4px; }
  .sig-contact a { color: #c9a84c; text-decoration: none; }
  .ai-disclosure { margin-top: 20px; padding: 16px 20px; background: #f9f7f3; border-radius: 4px; border: 1px solid #e8e0d0; }
  .ai-disclosure p { font-size: 12px; color: #5a6a85; line-height: 1.6; font-style: italic; }

  /* John's signature block (below Dani's) */
  .john-sig { margin-top: 24px; padding-top: 20px; border-top: 1px solid #e8e0d0; }

  /* IP Statement */
  .ip-statement { margin-top: 16px; padding: 12px 20px; text-align: center; }
  .ip-statement p { font-size: 10px; color: #8a9ab5; line-height: 1.5; font-style: italic; }

  /* Footer */
  .footer { background: #0d1b2e; padding: 28px 40px; text-align: center; }
  .footer-brand { font-size: 14px; color: #c9a84c; letter-spacing: 3px; margin-bottom: 4px; }
  .footer-tagline { font-size: 10px; color: #f5e9c8; letter-spacing: 2px; font-style: italic; margin-bottom: 10px; }
  .footer-contact { font-size: 12px; color: #d0d8e8; margin-top: 4px; }
  .footer-contact a { color: #c9a84c; text-decoration: none; }
  .footer-legal { font-size: 10px; color: #5a6a85; margin-top: 14px; line-height: 1.5; }
</style>
</head>
<body>
<center>
<table cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #eee8db;">
<tr><td align="center" style="padding: 20px 10px;">

<div class="wrapper">

  <!-- HEADER -->
  <div class="header">
    {% if logo_b64 %}
    <img src="data:image/png;base64,{{ logo_b64 }}" alt="Dreams2Memories Travel" style="max-width: 300px; height: auto;" />
    {% else %}
    <div style="font-family: 'Georgia', serif; font-size: 22px; color: #c9a84c; letter-spacing: 2px;">DREAMS2MEMORIES</div>
    <div style="font-family: 'Georgia', serif; font-size: 11px; color: #8a9ab5; letter-spacing: 3px; text-transform: uppercase; margin-top: 4px;">Travel, LLC</div>
    {% endif %}
    <div class="tagline">Curating the voyage of your lifetime</div>
  </div>
  <div class="gold-line"></div>
  <div class="hero-area"><span class="hero-text">{{ hero_text }}</span></div>
  <div class="gold-line"></div>

  <!-- CONTENT -->
  <div class="content">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- JOHN'S SECTION — normal navy text style                -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- A NOTE FROM JOHN -->
    <div class="section-divider"><span>A Note from John</span></div>
    <p class="body-text">{{ johns_note }}</p>
    <p class="body-text">{{ johns_note_2 }}</p>
    <p class="body-text">{{ johns_note_3 }}</p>
    <p class="body-text">{{ johns_note_4 }}</p>

    <!-- THE PROBLEM WORTH SOLVING -->
    <div class="section-divider"><span>The Problem Worth Solving</span></div>
    <p class="body-text">{{ problem_text }}</p>
    <p class="body-text">{{ problem_text_2 }}</p>

    <!-- John's handoff -->
    <p class="body-text">{{ johns_handoff }}</p>
    <p class="john-sign-off">&mdash; John</p>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- VOICE TRANSITION                                       -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <div class="voice-transition">
      <span class="voice-transition-label">Dani Moreau, Concierge Intelligence</span>
    </div>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- DANI'S SECTION — warm teal accent, left border         -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- Dani's greeting -->
    <div class="dani-greeting">{{ dani_greeting }}</div>

    <div class="dani-section">

      <!-- HOW JOHN BUILT IT -->
      <div class="section-divider"><span>How John Built It</span></div>
      <p class="body-text">{{ how_built_1 }}</p>
      <p class="body-text">{{ how_built_2 }}</p>
      <p class="body-text">{{ how_built_3 }}</p>
      <p class="body-text" style="font-weight: bold;">{{ how_built_4 }}</p>

      <!-- THE WING -->
      <div class="section-divider"><span>The Wing &mdash; Nine Specialists, One Mission</span></div>
      <p class="body-text">{{ wing_intro }}</p>

      <table class="staff-table">
        <thead>
          <tr><th>Role</th><th>Name</th><th>What They Do</th></tr>
        </thead>
        <tbody>
          {% for s in staff_roster %}
          <tr>
            <td class="role-name">{{ s.role }}</td>
            <td class="person-name">{{ s.name }}</td>
            <td>{{ s.desc }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>

      <p class="body-text">{{ wing_kicker }}</p>

      <!-- WHAT THIS MEANS FOR YOU -->
      <div class="section-divider"><span>What This Means for You</span></div>
      <p class="body-text">{{ what_we_do_intro }}</p>
      <p class="teaser">{{ what_we_do_teaser }}</p>

      <div class="phase-block">
        <div class="phase-title">{{ what_we_do_before_title }}</div>
        <div class="phase-text">{{ what_we_do_before }}</div>
      </div>

      <div class="phase-block">
        <div class="phase-title">{{ what_we_do_during_title }}</div>
        <div class="phase-text">{{ what_we_do_during }}</div>
      </div>

      <div class="phase-block">
        <div class="phase-title">{{ what_we_do_after_title }}</div>
        <div class="phase-text">{{ what_we_do_after }}</div>
      </div>

      <!-- THE MISSION -->
      <div class="section-divider"><span>The Mission</span></div>
      <div class="mission-quote"><p>&ldquo;{{ mission_quote }}&rdquo;</p></div>
      <p class="body-text">{{ mission_text }}</p>
      <p class="body-text">{{ mission_text_2 }}</p>
      <p class="mission-closer">{{ mission_closer }}</p>

      <!-- ATTACHMENT REFERENCE -->
      <div class="attachment-box">
        <div class="attachment-label">&#128206; Attached: John &amp; Susie&rsquo;s 32-Day Pacific Journey</div>
        <div class="attachment-intro">{{ attachment_intro }}</div>
        <div class="attachment-route">{{ attachment_summary }}</div>
        <div class="attachment-stats">{{ attachment_stats }}</div>
      </div>

      <!-- CTA -->
      <div class="cta-box">
        <div class="cta-title">Interested?</div>
        <div class="cta-text">{{ cta_text }}</div>
        <div class="cta-referral">{{ cta_referral }}</div>
        <div style="margin-top: 14px;" class="cta-contact">
          John Loucks &middot; <a href="mailto:concierge@d2mluxury.quest">concierge@d2mluxury.quest</a>
        </div>
      </div>

    </div><!-- end .dani-section -->

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- SIGNATURES — Dani first, then John                     -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <div style="margin-top: 32px;">

      <!-- DANI'S SIGNATURE -->
      <div class="sig-divider"></div>
      <table cellpadding="0" cellspacing="0" border="0">
        <tr>
          {% if avatar_b64 %}
          <td style="padding-right: 16px; vertical-align: top;">
            <img src="data:image/png;base64,{{ avatar_b64 }}" alt="Dani Moreau" width="64" height="64" style="width: 64px; height: 64px; border-radius: 50%; border: 2px solid #c9a84c;" />
          </td>
          {% endif %}
          <td style="vertical-align: top;">
            <div class="sig-name">Dani Moreau</div>
            <div class="sig-title">Luxury Travel Concierge</div>
            <div class="sig-company">DREAMS2MEMORIES TRAVEL</div>
            <div class="sig-contact"><a href="mailto:concierge@d2mluxury.quest">concierge@d2mluxury.quest</a></div>
          </td>
        </tr>
      </table>
      <div class="ai-disclosure">
        <p>{{ ai_disclosure }}</p>
      </div>

      <!-- JOHN'S SIGNATURE -->
      <div class="john-sig">
        <div class="sig-name">John Loucks</div>
        <div class="sig-title">Founder &amp; Travel Advisor</div>
        <div class="sig-company">DREAMS2MEMORIES TRAVEL, LLC</div>
        <div class="sig-contact"><a href="mailto:concierge@d2mluxury.quest">concierge@d2mluxury.quest</a></div>
      </div>

    </div>

    <!-- IP STATEMENT -->
    <div class="ip-statement">
      <p>{{ ip_statement }}</p>
    </div>

  </div>

  <!-- FOOTER -->
  <div class="gold-line"></div>
  <div class="footer">
    <div class="footer-brand">DREAMS2MEMORIES</div>
    <div class="footer-tagline">Curating the voyage of your lifetime</div>
    <div class="footer-contact"><a href="mailto:concierge@d2mluxury.quest">concierge@d2mluxury.quest</a></div>
    <div class="footer-legal">
      Florida Seller of Travel # ST1578 &middot; California Seller of Travel No. 2090937-50<br>
      Washington UBID No. 603189022 &middot; Iowa Registered Agency # 1202
    </div>
  </div>

</div>

</td></tr>
</table>
</center>
</body>
</html>
