/* D2M Brand CSS — Dreams2Memories Travel, LLC
   Base stylesheet for all PDF/HTML templates.
   Include via: { % include "d2m_base.css.j2" % }
*/

/* ── Brand Tokens ─────────────────────────────────────────────────── */
:root {
  --navy:        #0d1b2e;
  --navy2:       #152540;
  --navy3:       #1e3358;
  --gold:        #c9a84c;
  --gold-light:  #e8c97a;
  --gold-pale:   #f5e9c8;
  --cream:       #f7f3ea;
  --linen:       #eee8db;
  --ink:         #0000ff;
  --muted:       #8a9ab5;
  --text-light:  #e0e6ed;
  --text-dark:   #1a1a1a;
  --prestige:    #7a5a9a;
  --prestige-bg: #4a2a6a;
  --success:     #4caf50;
  --danger:      #ef5350;
  --warning:     #ffa726;
}

/* ── Reset & Base ─────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: Georgia, 'Times New Roman', serif;
  color: var(--text-light);
  background: var(--navy);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* ── Typography ───────────────────────────────────────────────────── */
h1, h2, h3 {
  font-family: Georgia, serif;
  color: var(--gold);
  font-weight: 400;
  letter-spacing: 0.02em;
}

h1 { font-size: 28px; margin-bottom: 16px; }
h2 { font-size: 22px; margin-bottom: 12px; border-bottom: 1px solid var(--navy3); padding-bottom: 8px; }
h3 { font-size: 16px; margin-bottom: 8px; color: var(--gold-light); }

p { margin-bottom: 12px; font-size: 14px; }
a { color: var(--gold); text-decoration: none; }
a:hover { color: var(--gold-light); text-decoration: underline; }

/* ── Layout ───────────────────────────────────────────────────────── */
.page {
  max-width: 900px;
  margin: 0 auto;
  padding: 40px 48px;
  background: var(--navy);
}

.section {
  background: var(--navy2);
  border-radius: 8px;
  padding: 24px;
  margin-bottom: 24px;
  border: 1px solid var(--navy3);
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

.section-icon {
  width: 36px;
  height: 36px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
}

/* ── Cards ────────────────────────────────────────────────────────── */
.card {
  background: var(--navy3);
  border-radius: 8px;
  padding: 20px;
  margin-bottom: 16px;
  border-left: 3px solid var(--gold);
}

.card-title {
  font-size: 16px;
  color: var(--gold);
  font-weight: 600;
  margin-bottom: 8px;
}

.card-meta {
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 12px;
}

/* ── Price Box ────────────────────────────────────────────────────── */
.price-box {
  background: linear-gradient(135deg, var(--navy3), var(--navy2));
  border: 1px solid var(--gold);
  border-radius: 8px;
  padding: 16px;
  text-align: center;
}

.price-box.prestige {
  border-color: var(--prestige);
  background: linear-gradient(135deg, var(--prestige-bg), var(--navy2));
}

.price-amount {
  font-size: 28px;
  color: var(--gold-light);
  font-weight: 700;
}

.price-box.prestige .price-amount {
  color: var(--prestige);
}

.price-label {
  font-size: 11px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

/* ── Tables ───────────────────────────────────────────────────────── */
table {
  width: 100%;
  border-collapse: collapse;
  margin: 12px 0;
  font-size: 13px;
}

th {
  background: var(--navy3);
  color: var(--gold);
  padding: 10px 12px;
  text-align: left;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  border-bottom: 2px solid var(--gold);
}

td {
  padding: 10px 12px;
  border-bottom: 1px solid var(--navy3);
  color: var(--text-light);
}

tr:hover td { background: rgba(201, 168, 76, 0.05); }
tr.is-pick td { background: rgba(201, 168, 76, 0.1); font-weight: 600; }

/* ── Badges ───────────────────────────────────────────────────────── */
.badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 12px;
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.badge.value      { background: rgba(76, 175, 80, 0.2);  color: var(--success); }
.badge.location   { background: rgba(33, 150, 243, 0.2); color: #64b5f6; }
.badge.experience { background: rgba(201, 168, 76, 0.2); color: var(--gold); }
.badge.luxury     { background: rgba(122, 90, 154, 0.2); color: var(--prestige); }
.badge.local      { background: rgba(255, 167, 38, 0.2); color: var(--warning); }
.badge.nearest    { background: var(--gold); color: var(--navy); font-weight: 700; }

/* ── Cancellation Policy ──────────────────────────────────────────── */
.cancel-ok  { color: var(--success); }
.cancel-no  { color: var(--danger); }
.cancel-tbd { color: var(--muted); font-style: italic; }

/* ── Photo Grid ───────────────────────────────────────────────────── */
.photo-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 8px;
  margin-bottom: 16px;
  border-radius: 8px;
  overflow: hidden;
}

.photo-grid img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.photo-grid .main { grid-row: 1 / 3; }

/* ── Cover Page ───────────────────────────────────────────────────── */
.cover {
  text-align: center;
  padding: 80px 40px;
  background: linear-gradient(180deg, var(--navy) 0%, var(--navy2) 100%);
  border-bottom: 3px solid var(--gold);
  margin-bottom: 40px;
}

.cover h1 {
  font-size: 36px;
  color: var(--cream);
  margin-bottom: 8px;
}

.cover .subtitle {
  font-size: 18px;
  color: var(--gold);
  font-style: italic;
  margin-bottom: 32px;
}

.cover .meta-strip {
  display: flex;
  justify-content: center;
  gap: 32px;
  color: var(--muted);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

/* ── Comparison Grid ──────────────────────────────────────────────── */
.comparison-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 16px;
}

.recommendation {
  background: linear-gradient(135deg, rgba(201, 168, 76, 0.1), var(--navy2));
  border: 2px solid var(--gold);
  border-radius: 8px;
  padding: 20px;
  text-align: center;
}

.recommendation .label {
  font-size: 10px;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 0.15em;
  margin-bottom: 8px;
}

/* ── Transport Grid ───────────────────────────────────────────────── */
.transport-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 12px;
}

.transport-card {
  background: var(--navy3);
  border-radius: 6px;
  padding: 16px;
  text-align: center;
}

.transport-card .icon { font-size: 24px; margin-bottom: 8px; }
.transport-card .mode { font-size: 11px; color: var(--muted); text-transform: uppercase; }
.transport-card .detail { font-size: 14px; color: var(--text-light); margin-top: 4px; }

/* ── Footer ───────────────────────────────────────────────────────── */
.footer {
  text-align: center;
  padding: 24px;
  color: var(--muted);
  font-size: 11px;
  border-top: 1px solid var(--navy3);
  margin-top: 40px;
}

.footer-brand {
  color: var(--gold);
  font-size: 12px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 4px;
}

/* ── Print ────────────────────────────────────────────────────────── */
@media print {
  body { background: white; color: var(--text-dark); }
  .page { max-width: none; padding: 20px; }
  .section { border-color: #ddd; break-inside: avoid; }
  .price-amount { color: var(--text-dark); }
  th { background: #f5f5f5; color: var(--text-dark); border-color: #ddd; }
  td { border-color: #eee; color: var(--text-dark); }
  .cover { border-color: #333; }
  .cover h1 { color: var(--text-dark); }
}

@page {
  size: A4;
  margin: 15mm 20mm;
}
