<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ subject | default('Dreams2Memories Travel') }}</title>
    <!-- NO external font imports — Georgia only, Gmail-compatible via premailer -->
    <style>

        /* ===== RESET ===== */
        * { margin: 0; padding: 0; box-sizing: border-box; }

        /* ===== DESIGN TOKENS — AFA Edition ===== */
        :root {
            --afa-blue:    #003087;
            --afa-dark:    #001a5c;
            --afa-deep:    #000d3a;
            --silver:      #A9B0B7;
            --silver-light:#d4d8de;
            --silver-pale: #f0f2f5;
            --ink:         #0000ff;   /* Commander's bright blue pen — NEVER substitute */
            --text-dark:   #2c2c2c;
            --text-muted:  #666666;
            --white:       #ffffff;
            --content-bg:  #ffffff;
            --table-alt:   #f5f7fc;
            --border:      #dde2ee;
        }

        /* ===== BASE ===== */
        body {
            font-family: Georgia, 'Times New Roman', serif;
            color: #0000ff;
            background: #1a1a2e;
            line-height: 1.75;
            font-size: 15px;
            -webkit-font-smoothing: antialiased;
        }

        /* ===== PRINT STYLES ===== */
        @media print {
            body { background: white; font-size: 12pt; color: #1a1a2e; }
            .email-wrapper { max-width: 100%; box-shadow: none; border: none; }
            .header { padding: 18pt 30pt 12pt; }
            .content { padding: 16pt 30pt; }
            .footer-agent { padding: 12pt 30pt; }
            .bottom-bar { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            a { color: #0000ff; text-decoration: none; }
            .no-print { display: none; }
        }

        /* ===== RESPONSIVE ===== */
        @media screen and (max-width: 620px) {
            .email-wrapper  { margin: 0; border-radius: 0; }
            .header         { padding: 20px 18px 14px; }
            .content        { padding: 20px 18px 24px; }
            .footer-agent   { padding: 16px 18px; }
            .bottom-bar     { padding: 10px 18px; }
            .agent-row      { flex-direction: column; align-items: flex-start; }
        }

        /* ===== OUTER WRAPPER ===== */
        .outer {
            max-width: 680px;
            margin: 24px auto;
            padding: 0 12px;
        }

        /* ===== EMAIL WRAPPER — WHITE PAPER ===== */
        .email-wrapper {
            max-width: 680px;
            margin: 0 auto;
            background: #ffffff;
            border: 2px solid #A9B0B7;
            border-radius: 4px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.5);
        }

        /* ===== HEADER — AFA BLUE LOGO BANNER ===== */
        .header {
            padding: 0;
            text-align: center;
            background: linear-gradient(135deg, #001a5c 0%, #003087 100%);
            border-radius: 4px 4px 0 0;
            overflow: hidden;
            position: relative;
        }

        .header-inner {
            padding: 28px 44px 22px;
            position: relative;
            z-index: 1;
        }

        .logo {
            max-height: 110px;
            width: auto;
            margin-bottom: 8px;
        }

        /* Fallback when no logo image provided */
        .logo-text {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 24px;
            font-weight: bold;
            color: #A9B0B7;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .logo-sub {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 9px;
            color: rgba(255,255,255,0.7);
            letter-spacing: 4px;
            text-transform: uppercase;
            margin-top: 2px;
        }

        .tagline {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 11px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.75);
            font-style: italic;
            margin-top: 8px;
        }

        /* ===== SILVER DIVIDER STRIPE ===== */
        .silver-rule {
            height: 3px;
            background: linear-gradient(90deg, #003087, #A9B0B7, #ffffff, #A9B0B7, #003087);
            margin: 0;
            border: none;
        }

        /* ===== META ROW: date + reference ===== */
        .meta-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            padding: 14px 44px 0;
            flex-wrap: wrap;
            gap: 6px;
            background: #ffffff;
        }

        .meta-date {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 11px;
            color: #666666;
            letter-spacing: 0.5px;
            font-style: italic;
        }

        .meta-ref {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 11px;
            color: #666666;
            letter-spacing: 0.5px;
            font-style: italic;
        }

        /* ===== SUBJECT LINE ===== */
        .subject-line {
            padding: 10px 44px 0;
            background: #ffffff;
        }

        .subject-line p {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 11px;
            font-weight: bold;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #003087;
            border-bottom: 1px solid #dde2ee;
            padding-bottom: 8px;
        }

        /* ===== CONTENT ===== */
        .content {
            padding: 12px 44px 32px;
            background: #ffffff;
        }

        .greeting {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 20px;
            font-weight: bold;
            color: #003087;
            margin-bottom: 18px;
            margin-top: 14px;
        }

        .content p {
            margin-bottom: 14px;
            color: #0000ff;
        }

        .content ul,
        .content ol {
            margin: 10px 0 14px 24px;
            color: #0000ff;
        }

        .content li {
            margin-bottom: 7px;
            color: #0000ff;
        }

        .content strong {
            color: #003087;
            font-weight: bold;
        }

        .content a {
            color: #A9B0B7;
            text-decoration: underline;
            text-decoration-color: #d4d8de;
            text-underline-offset: 3px;
        }

        /* ===== HIGHLIGHT BOX ===== */
        .highlight-box {
            background: linear-gradient(135deg, #f0f4ff, #e8ecf8);
            border-left: 3px solid #003087;
            padding: 16px 22px;
            margin: 20px 0;
            border-radius: 0 4px 4px 0;
        }

        .highlight-box .box-label {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 10px;
            font-weight: bold;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #003087;
            margin-bottom: 10px;
        }

        .highlight-box p {
            margin-bottom: 7px;
            font-size: 14px;
            color: #2c2c2c;
        }

        .highlight-box p:last-child { margin-bottom: 0; }

        /* ===== ACTION BOX ===== */
        .action-box {
            background: #f5f7fc;
            border: 1px solid #dde2ee;
            border-left: 3px solid #003087;
            padding: 16px 22px;
            margin: 20px 0;
            border-radius: 0 4px 4px 0;
        }

        .action-box .box-label {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 10px;
            font-weight: bold;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #003087;
            margin-bottom: 10px;
        }

        .action-item {
            font-size: 14px;
            color: #2c2c2c;
            padding: 4px 0 4px 18px;
            position: relative;
        }

        .action-item::before {
            content: "→";
            color: #A9B0B7;
            position: absolute;
            left: 0;
            font-weight: bold;
        }

        /* ===== SIGN-OFF ===== */
        .sign-off {
            margin-top: 30px;
            padding-top: 4px;
        }

        .sign-off .closing {
            margin-bottom: 4px;
            color: #0000ff;
        }

        .sign-off .sig-name {
            font-weight: bold;
            color: #003087;
            font-size: 16px;
            font-family: Georgia, 'Times New Roman', serif;
            letter-spacing: 0.3px;
        }

        .sign-off .sig-title {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 11px;
            color: #666666;
            letter-spacing: 0.5px;
        }

        /* ===== AI DISCLOSURE (optional) ===== */
        .ai-disclosure {
            margin-top: 20px;
            padding: 14px 18px;
            background: #f5f7fc;
            border-radius: 4px;
            border: 1px solid #dde2ee;
        }

        .ai-disclosure p {
            font-size: 11.5px;
            color: #5a6a85;
            line-height: 1.65;
            font-style: italic;
            margin: 0;
        }

        /* ===== FOOTER — AGENT CONTACT BLOCK ===== */
        .footer-agent {
            background: #f5f7fc;
            border-top: 1px solid #dde2ee;
            padding: 22px 44px;
        }

        .agent-row {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .agent-photo {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #A9B0B7;
            flex-shrink: 0;
        }

        .agent-photo-placeholder {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            background: #001a5c;
            border: 2px solid #A9B0B7;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 22px;
            color: #A9B0B7;
        }

        .agent-info { flex: 1; }

        .agent-name {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 17px;
            font-weight: bold;
            color: #003087;
        }

        .agent-title {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 10px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #A9B0B7;
            font-style: italic;
            margin-top: 1px;
        }

        .contact-line {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 12px;
            color: #666666;
            margin-top: 5px;
            line-height: 1.7;
        }

        .contact-line a {
            color: #0000ff;
            text-decoration: none;
        }

        .contact-line a:hover { text-decoration: underline; }

        .sep { color: #dde2ee; margin: 0 5px; }

        /* ===== BOTTOM BAR ===== */
        .bottom-bar {
            text-align: center;
            padding: 14px 44px 15px;
            background: linear-gradient(135deg, #001a5c 0%, #003087 100%);
            border-radius: 0 0 4px 4px;
        }

        .bottom-bar span {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 9px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #A9B0B7;
        }

        .bottom-bar .legal {
            font-size: 9px;
            letter-spacing: 0.5px;
            color: rgba(169,176,183,0.6);
            margin-top: 4px;
            display: block;
        }

    </style>
</head>
<body>
<div class="outer">
<div class="email-wrapper">

    <!-- ═══════════════════════════════════════
         HEADER — AFA BLUE LOGO BANNER
         D2M AFA stationery: USAFA Blue (#003087) gradient with centered logo.
         Logo: max-height 110px. Fallback text in silver if no image.
    ═══════════════════════════════════════ -->
    <div class="header">
        <div class="header-inner">
            {% if logo_b64 %}
            <img src="data:image/png;base64,{{ logo_b64 }}" alt="Dreams2Memories Travel" class="logo">
            {% elif logo_url %}
            <img src="{{ logo_url }}" alt="Dreams2Memories Travel" class="logo">
            {% else %}
            <div class="logo-text">Dreams2Memories</div>
            <div class="logo-sub">Travel, LLC</div>
            {% endif %}
            <div class="tagline">Curating the voyage of your lifetime</div>
        </div>
    </div>

    <hr class="silver-rule">

    <!-- ═══════════════════════════════════════
         META: DATE + REFERENCE
    ═══════════════════════════════════════ -->
    <div class="meta-row">
        <span class="meta-date">{{ date | default('') }}</span>
        {% if reference %}
        <span class="meta-ref">Ref: {{ reference }}</span>
        {% endif %}
    </div>

    <!-- ═══════════════════════════════════════
         OPTIONAL SUBJECT / DOCUMENT TITLE
    ═══════════════════════════════════════ -->
    {% if subject_display %}
    <div class="subject-line">
        <p>{{ subject_display }}</p>
    </div>
    {% endif %}

    <!-- ═══════════════════════════════════════
         BODY CONTENT
         All text: bright blue (#0000ff), Georgia serif.
         White paper area (#ffffff) set on .content.
    ═══════════════════════════════════════ -->
    <div class="content">

        <div class="greeting">{{ greeting | default('Dear Valued Traveler,') }}</div>

        {{ body_html }}

        <!-- ─── HIGHLIGHT BOX (optional — booking ref, travel dates, key detail) ───
        <div class="highlight-box">
            <div class="box-label">Booking Summary</div>
            <p><strong>Booking Reference:</strong> XXXXXX</p>
            <p><strong>Travel Dates:</strong> Month DD – DD, YYYY</p>
            <p><strong>Destination:</strong> City, Country</p>
            <p><strong>Ship / Property:</strong> _______________</p>
        </div>
        ─── -->

        <!-- ─── ACTION BOX (optional — next steps, items needed from client) ───
        <div class="action-box">
            <div class="box-label">A Few Items to Note</div>
            <div class="action-item">Passport copies due by [DATE]</div>
            <div class="action-item">Final payment due [DATE] — $X,XXX</div>
            <div class="action-item">Please confirm [details]</div>
        </div>
        ─── -->

        <!-- SIGN-OFF: "Thanks" or "Thank you" — NEVER "Best" -->
        <div class="sign-off">
            <p class="closing">{{ closing | default('Thank you') }},</p>
            <p class="sig-name">{{ agent_name | default('John Loucks') }}</p>
            <p class="sig-title">{{ agent_title | default('Luxury Travel Advisor · Dreams2Memories Travel') }}</p>
        </div>

        <!-- AI DISCLOSURE — include when Dani sends, omit when John sends directly -->
        {% if show_ai_disclosure %}
        <div class="ai-disclosure">
            <p>Dani Moreau is your dedicated concierge at Dreams2Memories Travel &mdash; an AI-powered specialist designed to ensure every detail of your journey receives the attention it deserves. She operates under the direct oversight of John Loucks, your travel advisor, who reviews every recommendation and personally stands behind every communication. Think of Dani as the reason your experience feels effortless &mdash; because someone is always watching the details, even when you&rsquo;re not.</p>
        </div>
        {% endif %}

    </div>

    <!-- ═══════════════════════════════════════
         FOOTER — AGENT CONTACT BLOCK
         NOTE: Phone NOT included in defaults — John gives it selectively.
         Pass agent_phone / agent_phone_display explicitly when appropriate.
    ═══════════════════════════════════════ -->
    <div class="footer-agent">
        <div class="agent-row">
            {% if agent_photo_b64 %}
            <img src="data:image/png;base64,{{ agent_photo_b64 }}" alt="{{ agent_name | default('John Loucks') }}" class="agent-photo">
            {% elif agent_photo_url %}
            <img src="{{ agent_photo_url }}" alt="{{ agent_name | default('John Loucks') }}" class="agent-photo">
            {% else %}
            <div class="agent-photo-placeholder">{{ (agent_name | default('J'))[0] }}</div>
            {% endif %}
            <div class="agent-info">
                <div class="agent-name">{{ agent_name | default('John Loucks') }}</div>
                <div class="agent-title">{{ agent_title | default('Luxury Travel Advisor') }}</div>
                <div class="contact-line">
                    {% if agent_phone %}
                    <a href="tel:{{ agent_phone }}">{{ agent_phone_display | default(agent_phone) }}</a>
                    <span class="sep">·</span>
                    {% endif %}
                    <a href="mailto:{{ agent_email | default('concierge@d2mluxury.quest') }}">{{ agent_email | default('concierge@d2mluxury.quest') }}</a>
                    {% if show_telegram | default(true) %}
                    <span class="sep">·</span>
                    <a href="https://t.me/d2m_dani_bot">Telegram</a>
                    {% endif %}
                    <span class="sep">·</span>
                    <a href="https://d2mluxury.quest">d2mluxury.quest</a>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════
         BOTTOM BAR
    ═══════════════════════════════════════ -->
    <div class="bottom-bar">
        <span>Dreams2Memories Travel, LLC &nbsp;&middot;&nbsp; Monument, CO</span>
        <span class="legal">
            FL ST1578 &nbsp;·&nbsp; CA 2090937-50 &nbsp;·&nbsp; WA UBID 603189022 &nbsp;·&nbsp; IA 1202
        </span>
    </div>

</div><!-- /email-wrapper -->
</div><!-- /outer -->
</body>
</html>
