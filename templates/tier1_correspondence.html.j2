<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ subject | default('Dreams2Memories Travel') }}</title>
    <!-- NO external font imports — Georgia only, Gmail-compatible via premailer -->
    <style>

        /* ===== RESET ===== */
        * { margin: 0; padding: 0; box-sizing: border-box; }

        /* ===== DESIGN TOKENS ===== */
        :root {
            --gold:        #c9a84c;
            --gold-light:  #e8c97a;
            --gold-pale:   #f5e9c8;
            --navy:        #0d1b2e;
            --navy-light:  #1e3358;
            --ink:         #0000ff;   /* Commander's bright blue pen — NEVER substitute */
            --text-dark:   #2d3748;
            --text-muted:  #718096;
            --cream:       #f7f3ea;   /* Crane's Ecru card stock — email content area */
            --linen:       #eee8db;   /* Warm linen desk surround */
            --sand:        #e8dcc8;
            --border-light:#e2e0db;
        }

        /* ===== BASE ===== */
        body {
            font-family: Georgia, 'Times New Roman', serif;
            color: #0000ff;
            background: #eee8db;
            line-height: 1.75;
            font-size: 15px;
            -webkit-font-smoothing: antialiased;
        }

        /* ===== PRINT STYLES ===== */
        @media print {
            body { background: white; font-size: 12pt; color: #1a1a2e; }
            .email-wrapper { max-width: 100%; box-shadow: none; border: none; }
            .header { padding: 18pt 30pt 12pt; }
            .content { padding: 16pt 30pt; }
            .footer-agent { padding: 12pt 30pt; }
            .bottom-bar { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            a { color: #0000ff; text-decoration: none; }
            .no-print { display: none; }
        }

        /* ===== RESPONSIVE ===== */
        @media screen and (max-width: 620px) {
            .email-wrapper  { margin: 0; border-radius: 0; }
            .header         { padding: 20px 18px 14px; }
            .content        { padding: 20px 18px 24px; }
            .footer-agent   { padding: 16px 18px; }
            .bottom-bar     { padding: 10px 18px; }
            .agent-row      { flex-direction: column; align-items: flex-start; }
        }

        /* ===== OUTER WRAPPER ===== */
        .outer {
            max-width: 680px;
            margin: 24px auto;
            padding: 0 12px;
        }

        /* ===== EMAIL WRAPPER — CREAM PAPER ===== */
        .email-wrapper {
            max-width: 680px;
            margin: 0 auto;
            background: #f7f3ea;
            border: 1px solid #e8dcc8;
            border-radius: 4px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        }

        /* ===== HEADER — NAVY LOGO BANNER ===== */
        .header {
            padding: 28px 44px 20px;
            text-align: center;
            background: #0d1b2e;
            border-radius: 4px 4px 0 0;
        }

        .logo {
            max-height: 90px;
            width: auto;
            margin-bottom: 6px;
        }

        /* Fallback when no logo image provided */
        .logo-text {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 24px;
            font-weight: bold;
            color: #c9a84c;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .logo-sub {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 9px;
            color: #f5e9c8;
            letter-spacing: 4px;
            text-transform: uppercase;
            margin-top: 2px;
        }

        .tagline {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 10px;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            color: #f5e9c8;
            font-style: italic;
            margin-top: 8px;
        }

        /* ===== GOLD RULE ===== */
        .gold-rule {
            height: 2.5px;
            background: linear-gradient(90deg, #0d1b2e 5%, #c9a84c 30%, #c9a84c 70%, #0d1b2e 95%);
            margin: 0;
            border: none;
        }

        /* ===== META ROW: date + reference ===== */
        .meta-row {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            padding: 14px 44px 0;
            flex-wrap: wrap;
            gap: 6px;
        }

        .meta-date {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 11px;
            color: #718096;
            letter-spacing: 0.5px;
            font-style: italic;
        }

        .meta-ref {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 11px;
            color: #718096;
            letter-spacing: 0.5px;
            font-style: italic;
        }

        /* ===== SUBJECT LINE (optional, e.g. Trip Validation) ===== */
        .subject-line {
            padding: 10px 44px 0;
        }

        .subject-line p {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 11px;
            font-weight: bold;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #0d1b2e;
            border-bottom: 1px solid #e8dcc8;
            padding-bottom: 8px;
        }

        /* ===== CONTENT ===== */
        .content {
            padding: 12px 44px 32px;
        }

        .greeting {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 20px;
            font-weight: bold;
            color: #0d1b2e;
            margin-bottom: 18px;
            margin-top: 14px;
        }

        .content p {
            margin-bottom: 14px;
            color: #0000ff;
        }

        .content ul,
        .content ol {
            margin: 10px 0 14px 24px;
            color: #0000ff;
        }

        .content li {
            margin-bottom: 7px;
            color: #0000ff;
        }

        .content strong {
            color: #0d1b2e;
            font-weight: bold;
        }

        .content a {
            color: #c9a84c;
            text-decoration: underline;
            text-decoration-color: #f5e9c8;
            text-underline-offset: 3px;
        }

        /* ===== HIGHLIGHT BOX — key details, booking summaries ===== */
        .highlight-box {
            background: #faf8f3;
            border-left: 3px solid #c9a84c;
            padding: 16px 22px;
            margin: 20px 0;
            border-radius: 0 4px 4px 0;
        }

        .highlight-box .box-label {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 10px;
            font-weight: bold;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #c9a84c;
            margin-bottom: 10px;
        }

        .highlight-box p {
            margin-bottom: 7px;
            font-size: 14px;
            color: #2d3748;
        }

        .highlight-box p:last-child { margin-bottom: 0; }

        /* ===== ACTION BOX — next steps, items needed ===== */
        .action-box {
            background: #faf8f3;
            border: 1px solid #e8dcc8;
            border-left: 3px solid #0d1b2e;
            padding: 16px 22px;
            margin: 20px 0;
            border-radius: 0 4px 4px 0;
        }

        .action-box .box-label {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 10px;
            font-weight: bold;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: #0d1b2e;
            margin-bottom: 10px;
        }

        .action-item {
            font-size: 14px;
            color: #2d3748;
            padding: 4px 0 4px 18px;
            position: relative;
        }

        .action-item::before {
            content: "→";
            color: #c9a84c;
            position: absolute;
            left: 0;
            font-weight: bold;
        }

        /* ===== SIGN-OFF ===== */
        .sign-off {
            margin-top: 30px;
            padding-top: 4px;
        }

        .sign-off .closing {
            margin-bottom: 4px;
            color: #0000ff;
        }

        .sign-off .sig-name {
            font-weight: bold;
            color: #0d1b2e;
            font-size: 16px;
            font-family: Georgia, 'Times New Roman', serif;
            letter-spacing: 0.3px;
        }

        .sign-off .sig-title {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 11px;
            color: #718096;
            letter-spacing: 0.5px;
        }

        /* ===== AI DISCLOSURE (optional) ===== */
        .ai-disclosure {
            margin-top: 20px;
            padding: 14px 18px;
            background: #f9f7f3;
            border-radius: 4px;
            border: 1px solid #e8dcc8;
        }

        .ai-disclosure p {
            font-size: 11.5px;
            color: #5a6a85;
            line-height: 1.65;
            font-style: italic;
            margin: 0;
        }

        /* ===== FOOTER — AGENT CONTACT BLOCK ===== */
        .footer-agent {
            background: #faf8f3;
            border-top: 1px solid #e8dcc8;
            padding: 22px 44px;
        }

        .agent-row {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .agent-photo {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #f5e9c8;
            flex-shrink: 0;
        }

        .agent-photo-placeholder {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            background: #1e3358;
            border: 2px solid #f5e9c8;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 22px;
            color: #c9a84c;
        }

        .agent-info { flex: 1; }

        .agent-name {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 17px;
            font-weight: bold;
            color: #0d1b2e;
        }

        .agent-title {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 10px;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #c9a84c;
            font-style: italic;
            margin-top: 1px;
        }

        .contact-line {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 12px;
            color: #718096;
            margin-top: 5px;
            line-height: 1.7;
        }

        .contact-line a {
            color: #0000ff;
            text-decoration: none;
        }

        .contact-line a:hover { text-decoration: underline; }

        .sep { color: #e8dcc8; margin: 0 5px; }

        /* ===== BOTTOM BAR ===== */
        .bottom-bar {
            text-align: center;
            padding: 10px 44px 11px;
            background: #0d1b2e;
            border-radius: 0 0 4px 4px;
        }

        .bottom-bar span {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 9px;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #c9a84c;
        }

        .bottom-bar .legal {
            font-size: 9px;
            letter-spacing: 0.5px;
            color: #5a6a85;
            margin-top: 3px;
            display: block;
        }

    </style>
</head>
<body>
<div class="outer">
<div class="email-wrapper">

    <!-- ═══════════════════════════════════════
         HEADER — NAVY LOGO BANNER
         Brand standard: full-width navy (#0d1b2e) with centered D2M logo.
         Logo: max-height 90px. Fallback text in gold if no image.
    ═══════════════════════════════════════ -->
    <div class="header">
        {% if logo_b64 %}
        <img src="data:image/png;base64,{{ logo_b64 }}" alt="Dreams2Memories Travel" class="logo">
        {% elif logo_url %}
        <img src="{{ logo_url }}" alt="Dreams2Memories Travel" class="logo">
        {% else %}
        <div class="logo-text">Dreams2Memories</div>
        <div class="logo-sub">Travel, LLC</div>
        {% endif %}
        <div class="tagline">Luxury Travel, Personally Crafted</div>
    </div>

    <hr class="gold-rule">

    <!-- ═══════════════════════════════════════
         META: DATE + REFERENCE
    ═══════════════════════════════════════ -->
    <div class="meta-row">
        <span class="meta-date">{{ date | default('') }}</span>
        {% if reference %}
        <span class="meta-ref">Ref: {{ reference }}</span>
        {% endif %}
    </div>

    <!-- ═══════════════════════════════════════
         OPTIONAL SUBJECT / DOCUMENT TITLE
         (use for Trip Validation, Proposals, Booking Confirmations)
    ═══════════════════════════════════════ -->
    {% if subject_display %}
    <div class="subject-line">
        <p>{{ subject_display }}</p>
    </div>
    {% endif %}

    <!-- ═══════════════════════════════════════
         BODY CONTENT
         All text: bright blue (#0000ff), Georgia serif.
         Cream paper area (#f7f3ea) set on .email-wrapper.
    ═══════════════════════════════════════ -->
    <div class="content">

        <div class="greeting">{{ greeting | default('Dear Valued Traveler,') }}</div>

        {{ body_html }}

        <!-- ─── HIGHLIGHT BOX (optional — booking ref, travel dates, key detail) ───
        <div class="highlight-box">
            <div class="box-label">Booking Summary</div>
            <p><strong>Booking Reference:</strong> XXXXXX</p>
            <p><strong>Travel Dates:</strong> Month DD – DD, YYYY</p>
            <p><strong>Destination:</strong> City, Country</p>
            <p><strong>Ship / Property:</strong> _______________</p>
        </div>
        ─── -->

        <!-- ─── ACTION BOX (optional — next steps, items needed from client) ───
        <div class="action-box">
            <div class="box-label">A Few Items to Note</div>
            <div class="action-item">Passport copies due by [DATE]</div>
            <div class="action-item">Final payment due [DATE] — $X,XXX</div>
            <div class="action-item">Please confirm [details]</div>
        </div>
        ─── -->

        <!-- SIGN-OFF: "Thanks" or "Thank you" — NEVER "Best" -->
        <div class="sign-off">
            <p class="closing">{{ closing | default('Thank you') }},</p>
            <p class="sig-name">{{ agent_name | default('John Loucks') }}</p>
            <p class="sig-title">{{ agent_title | default('Luxury Travel Advisor · Dreams2Memories Travel') }}</p>
        </div>

        <!-- AI DISCLOSURE — include when Dani sends, omit when John sends directly -->
        {% if show_ai_disclosure %}
        <div class="ai-disclosure">
            <p>Dani Moreau is your dedicated concierge at Dreams2Memories Travel &mdash; an AI-powered specialist designed to ensure every detail of your journey receives the attention it deserves. She operates under the direct oversight of John Loucks, your travel advisor, who reviews every recommendation and personally stands behind every communication. Think of Dani as the reason your experience feels effortless &mdash; because someone is always watching the details, even when you&rsquo;re not.</p>
        </div>
        {% endif %}

    </div>

    <!-- ═══════════════════════════════════════
         FOOTER — AGENT CONTACT BLOCK
         NOTE: Phone NOT included in defaults — John gives it selectively.
         Pass agent_phone / agent_phone_display explicitly when appropriate.
    ═══════════════════════════════════════ -->
    <div class="footer-agent">
        <div class="agent-row">
            {% if agent_photo_b64 %}
            <img src="data:image/png;base64,{{ agent_photo_b64 }}" alt="{{ agent_name | default('John Loucks') }}" class="agent-photo">
            {% elif agent_photo_url %}
            <img src="{{ agent_photo_url }}" alt="{{ agent_name | default('John Loucks') }}" class="agent-photo">
            {% else %}
            <div class="agent-photo-placeholder">{{ (agent_name | default('J'))[0] }}</div>
            {% endif %}
            <div class="agent-info">
                <div class="agent-name">{{ agent_name | default('John Loucks') }}</div>
                <div class="agent-title">{{ agent_title | default('Luxury Travel Advisor') }}</div>
                <div class="contact-line">
                    {% if agent_phone %}
                    <a href="tel:{{ agent_phone }}">{{ agent_phone_display | default(agent_phone) }}</a>
                    <span class="sep">·</span>
                    {% endif %}
                    <a href="mailto:{{ agent_email | default('concierge@d2mluxury.quest') }}">{{ agent_email | default('concierge@d2mluxury.quest') }}</a>
                    {% if show_telegram | default(true) %}
                    <span class="sep">·</span>
                    <a href="https://t.me/d2m_dani_bot">Telegram</a>
                    {% endif %}
                    <span class="sep">·</span>
                    <a href="https://d2mluxury.quest">d2mluxury.quest</a>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════
         BOTTOM BAR
    ═══════════════════════════════════════ -->
    <div class="bottom-bar">
        <span>Dreams2Memories Travel, LLC &nbsp;&middot;&nbsp; Monument, CO</span>
        <span class="legal">
            FL ST1578 &nbsp;·&nbsp; CA 2090937-50 &nbsp;·&nbsp; WA UBID 603189022 &nbsp;·&nbsp; IA 1202
        </span>
    </div>

</div><!-- /email-wrapper -->
</div><!-- /outer -->
</body>
</html>
