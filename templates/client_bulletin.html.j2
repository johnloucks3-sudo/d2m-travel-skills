<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!--[if mso]><meta http-equiv="X-UA-Compatible" content="IE=Edge"><![endif]-->
{# Support both new BulletinContent.subject (via bulletin object) and legacy theme variable #}
{% set page_title = bulletin.subject if bulletin is defined else theme | default('Curated Discoveries') %}
<title>{{ page_title }} — Dreams2Memories Travel</title>
<style>
  /* ── Email client reset ───────────────────────────────────────────── */
  body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
  table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
  img { -ms-interpolation-mode: bicubic; border: 0; height: auto; line-height: 100%; outline: none; text-decoration: none; }
  body { margin: 0; padding: 0; }
  /* ── Outlook button fix ───────────────────────────────────────────── */
  .button-td, .button-a { transition: all 100ms ease-in; }
  .button-td-primary:hover, .button-a-primary:hover { background: #b8943e !important; border-color: #b8943e !important; }
  /* ── Media queries ────────────────────────────────────────────────── */
  @media screen and (max-width: 600px) {
    .email-container { width: 100% !important; }
    .stack-on-mobile { display: block !important; width: 100% !important; }
    .mobile-padding { padding: 20px 16px !important; }
    .excursion-cell { display: block !important; width: 100% !important; padding: 0 0 16px 0 !important; }
    .hero-text-outer { padding: 32px 20px !important; }
    .featured-img { height: 200px !important; }
    .voyage-copy-cell { padding: 24px 20px !important; }
  }
</style>
</head>
<body style="background-color: #eee8db; margin: 0; padding: 0; font-family: Georgia, 'Times New Roman', serif;">

<!-- ══════════════════════════════════════════════════════════════════════════
     OUTER WRAPPER — linen surround (email client background)
══════════════════════════════════════════════════════════════════════════ -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #eee8db;">
<tr>
<td style="padding: 24px 12px;">

  <!-- ══════════════════════════════════════════════════════════════════
       INNER EMAIL WRAPPER — max 600px, cream paper
  ══════════════════════════════════════════════════════════════════════ -->
  <table role="presentation" class="email-container" cellspacing="0" cellpadding="0" border="0"
         width="600" align="center"
         style="margin: 0 auto; background-color: #ffffff; box-shadow: 0 2px 16px rgba(0,0,0,0.10);">

    <!-- ──────────────────────────────────────────────────────────────
         HEADER — navy banner, D2M logo, gold wordmark
    ─────────────────────────────────────────────────────────────── -->
    <tr>
      <td style="background-color: #0d1b2e; padding: 28px 0 22px; text-align: center;">
        {% if logo_b64 %}
        <img src="data:image/png;base64,{{ logo_b64 }}"
             alt="Dreams2Memories Travel"
             width="200" height="auto"
             style="display: block; margin: 0 auto 10px; height: auto; width: 200px;">
        {% elif logo_url %}
        <img src="{{ logo_url }}"
             alt="Dreams2Memories Travel"
             width="200" height="auto"
             style="display: block; margin: 0 auto 10px; height: auto; width: 200px;">
        {% else %}
        <div style="font-family: Georgia, serif; font-size: 22px; font-weight: 400; color: #f7f3ea;
                    letter-spacing: 3px; text-transform: uppercase; margin-bottom: 4px;">
          Dreams2Memories
        </div>
        <div style="font-family: Georgia, serif; font-size: 11px; color: #c9a84c;
                    letter-spacing: 5px; text-transform: uppercase;">
          Travel, LLC
        </div>
        {% endif %}
        <!-- Gold rule -->
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="240" align="center"
               style="margin: 12px auto 10px;">
          <tr><td style="height: 1px; background: linear-gradient(90deg, transparent, #c9a84c, transparent);
                         font-size: 1px; line-height: 1px;">&nbsp;</td></tr>
        </table>
        <div style="font-family: Georgia, serif; font-size: 10px; color: #c9a84c;
                    letter-spacing: 4px; text-transform: uppercase;">
          Curated by Dreams2Memories Travel
        </div>
      </td>
    </tr>

    <!-- ──────────────────────────────────────────────────────────────
         EDITION STRIP — season + date
    ─────────────────────────────────────────────────────────────── -->
    <tr>
      <td style="background-color: #152540; padding: 9px 32px; text-align: center;">
        <span style="font-family: Georgia, serif; font-size: 10px; color: #8a9ab5;
                     letter-spacing: 3px; text-transform: uppercase;">
          {% if bulletin is defined %}
            {{ bulletin.created_date | default('') }}
          {% else %}
            {{ season | default('Spring 2026') }}&nbsp;&nbsp;·&nbsp;&nbsp;{{ edition_date | default('') }}
          {% endif %}
        </span>
      </td>
    </tr>

    <!-- ──────────────────────────────────────────────────────────────
         HERO — full-width destination image with overlay text
    ─────────────────────────────────────────────────────────────── -->
    <tr>
      <td style="padding: 0; position: relative; font-size: 0; line-height: 0;">
        {% if hero_image %}
        <div style="position: relative; overflow: hidden;">
          <img src="{{ hero_image }}"
               alt="{{ theme | default('Curated Discoveries') }}"
               width="600"
               class="featured-img"
               style="display: block; width: 100%; height: 320px; object-fit: cover;
                      object-position: center;">
          <!-- Gradient overlay -->
          <div style="position: absolute; inset: 0;
                      background: linear-gradient(180deg, rgba(13,27,46,0.15) 0%, rgba(13,27,46,0.72) 100%);">
          </div>
          <!-- Overlay text -->
          <div class="hero-text-outer"
               style="position: absolute; bottom: 0; left: 0; right: 0; padding: 40px 36px 32px;">
            <div style="font-family: Georgia, serif; font-size: 11px; color: #c9a84c;
                        letter-spacing: 4px; text-transform: uppercase; margin-bottom: 8px;">
              {{ season | default('This Season') }}
            </div>
            <div style="font-family: Georgia, serif; font-size: 30px; font-weight: 400; color: #f7f3ea;
                        line-height: 1.25; letter-spacing: 0.5px;">
              {{ theme | default("This Month's Discoveries") }}
            </div>
            {% if hero_tagline %}
            <div style="font-family: Georgia, serif; font-size: 14px; color: #e8c97a;
                        font-style: italic; margin-top: 8px; line-height: 1.5;">
              {{ hero_tagline }}
            </div>
            {% endif %}
          </div>
        </div>
        {% else %}
        <!-- Fallback: no hero image — stylized banner -->
        <div style="background: linear-gradient(135deg, #0d1b2e 0%, #152540 60%, #1e3358 100%);
                    padding: 56px 36px; text-align: center;">
          <div style="font-family: Georgia, serif; font-size: 11px; color: #c9a84c;
                      letter-spacing: 4px; text-transform: uppercase; margin-bottom: 10px;">
            {{ season | default('This Season') }}
          </div>
          <div style="font-family: Georgia, serif; font-size: 32px; color: #f7f3ea;
                      font-weight: 400; letter-spacing: 0.5px; line-height: 1.25;">
            {{ theme | default("This Month's Discoveries") }}
          </div>
          {% if hero_tagline %}
          <div style="font-family: Georgia, serif; font-size: 14px; color: #e8c97a;
                      font-style: italic; margin-top: 10px;">
            {{ hero_tagline }}
          </div>
          {% endif %}
        </div>
        {% endif %}
      </td>
    </tr>

    <!-- ──────────────────────────────────────────────────────────────
         GREETING + PERSONAL NOTE
         Handles: new BulletinContent.greeting / sections model
                  AND legacy personal_note field
    ─────────────────────────────────────────────────────────────── -->
    {% if bulletin is defined %}
    <tr>
      <td style="background-color: #f7f3ea; padding: 28px 36px 20px; border-bottom: 1px solid #e8dcc8;">
        <p style="font-family: Georgia, serif; font-size: 15px; color: #0000ff;
                  line-height: 1.75; margin: 0;">
          {{ greeting | default(bulletin.greeting) }}
        </p>
      </td>
    </tr>
    {% elif personal_note %}
    <tr>
      <td style="background-color: #f7f3ea; padding: 28px 36px 20px; border-bottom: 1px solid #e8dcc8;">
        <p style="font-family: Georgia, serif; font-size: 15px; color: #0000ff;
                  line-height: 1.75; margin: 0; font-style: italic;">
          {{ personal_note | replace('\n', '<br>') }}
        </p>
      </td>
    </tr>
    {% endif %}

    <!-- ══════════════════════════════════════════════════════════════
         NEW MODEL — BulletinSection list rendering
         Only rendered when bulletin object is present (new API)
    ══════════════════════════════════════════════════════════════ -->
    {% if bulletin is defined and bulletin.sections %}
    {% for section in bulletin.sections %}
    <tr>
      <td style="background-color: #f7f3ea; padding: 28px 36px 0;">
        <!-- Section label -->
        <div style="display: inline-block; border-bottom: 2px solid #c9a84c;
                    padding-bottom: 4px; margin-bottom: 16px;">
          <span style="font-family: Georgia, serif; font-size: 10px; color: #0d1b2e;
                       letter-spacing: 4px; text-transform: uppercase; font-weight: 600;">
            {{ section.title }}
          </span>
        </div>
        {% if section.image_url %}
        <div style="margin-bottom: 14px;">
          <img src="{{ section.image_url }}" alt="{{ section.title }}"
               style="display:block; width:100%; height:auto; max-height:280px;
                      object-fit:cover;">
        </div>
        {% endif %}
        <div style="font-family: Georgia, serif; font-size: 14px; color: #0000ff;
                    line-height: 1.75; margin-bottom: {{ '20px' if section.cta_text else '0' }};">
          {{ section.body | safe }}
        </div>
        {% if section.cta_text and section.cta_link %}
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin-top: 16px; margin-bottom: 8px;">
          <tr>
            <td style="background-color: #0d1b2e;">
              <a href="{{ section.cta_link }}"
                 style="display: inline-block; background-color: #0d1b2e; color: #c9a84c;
                        font-family: Georgia, serif; font-size: 10px; font-weight: 600;
                        letter-spacing: 2px; text-transform: uppercase; text-decoration: none;
                        padding: 10px 22px;">
                {{ section.cta_text }}
              </a>
            </td>
          </tr>
        </table>
        {% endif %}
      </td>
    </tr>
    {% if not loop.last %}
    <tr>
      <td style="background-color: #f7f3ea; padding: 0 36px;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
          <tr><td style="height: 1px; background-color: #e0d8c8; font-size: 1px;">&nbsp;</td></tr>
        </table>
      </td>
    </tr>
    {% endif %}
    {% endfor %}

    <!-- Closing sign-off -->
    <tr>
      <td style="background-color: #f7f3ea; padding: 28px 36px;">
        <p style="font-family: Georgia, serif; font-size: 14px; color: #0d1b2e;
                  line-height: 1.75; margin: 0;">
          {{ bulletin.closing | safe }}
        </p>
      </td>
    </tr>
    {% endif %}

    <!-- ══════════════════════════════════════════════════════════════
         LEGACY SECTION DIVIDER helper macro (inline)
    ══════════════════════════════════════════════════════════════ -->

    <!-- ──────────────────────────────────────────────────────────────
         LEGACY FEATURED VOYAGE — large card (only in legacy mode)
    ─────────────────────────────────────────────────────────────── -->
    {% if featured_voyage and bulletin is not defined %}
    <tr>
      <td style="background-color: #f7f3ea; padding: 32px 36px 0;">
        <!-- Section label -->
        <div style="display: inline-block; border-bottom: 2px solid #c9a84c;
                    padding-bottom: 4px; margin-bottom: 20px;">
          <span style="font-family: Georgia, serif; font-size: 10px; color: #0d1b2e;
                       letter-spacing: 4px; text-transform: uppercase; font-weight: 600;">
            Featured Voyage
          </span>
        </div>
      </td>
    </tr>
    <tr>
      <td style="background-color: #f7f3ea; padding: 0 36px 36px;">
        <!-- Voyage card -->
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
               style="background-color: #ffffff; border: 1px solid #e2e0db;
                      box-shadow: 0 2px 8px rgba(0,0,0,0.06);">
          <!-- Voyage hero image -->
          {% if featured_voyage.image %}
          <tr>
            <td style="padding: 0; font-size: 0; line-height: 0; overflow: hidden;">
              <img src="{{ featured_voyage.image }}"
                   alt="{{ featured_voyage.name | default('Featured Voyage') }}"
                   width="528"
                   style="display: block; width: 100%; height: 240px; object-fit: cover;
                          object-position: center;">
            </td>
          </tr>
          {% endif %}
          <!-- Cruise line badge row -->
          <tr>
            <td style="background-color: #0d1b2e; padding: 10px 20px;">
              <span style="font-family: Georgia, serif; font-size: 10px; color: #c9a84c;
                           letter-spacing: 3px; text-transform: uppercase;">
                {{ featured_voyage.line | default('') }}
              </span>
            </td>
          </tr>
          <!-- Voyage copy -->
          <tr>
            <td class="voyage-copy-cell" style="padding: 24px 24px 20px;">
              <div style="font-family: Georgia, serif; font-size: 20px; color: #0d1b2e;
                          font-weight: 400; line-height: 1.3; margin-bottom: 8px;">
                {{ featured_voyage.name | default('') }}
              </div>
              {% if featured_voyage.dates %}
              <div style="font-family: Georgia, serif; font-size: 11px; color: #8a9ab5;
                          letter-spacing: 2px; text-transform: uppercase; margin-bottom: 16px;">
                {{ featured_voyage.dates }}
              </div>
              {% endif %}
              {% if featured_voyage.description %}
              <p style="font-family: Georgia, serif; font-size: 14px; color: #0000ff;
                        line-height: 1.75; margin: 0 0 16px;">
                {{ featured_voyage.description }}
              </p>
              {% endif %}
              <!-- Ports highlight -->
              {% if featured_voyage.ports %}
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
                     style="border-top: 1px solid #e8dcc8; padding-top: 14px; margin-top: 4px;">
                <tr>
                  <td style="padding-top: 14px;">
                    <div style="font-family: Georgia, serif; font-size: 10px; color: #8a9ab5;
                                letter-spacing: 3px; text-transform: uppercase; margin-bottom: 8px;">
                      Ports of Call
                    </div>
                    <div style="font-family: Georgia, serif; font-size: 13px; color: #0d1b2e;
                                line-height: 1.7;">
                      {{ featured_voyage.ports | join(' &nbsp;·&nbsp; ') if featured_voyage.ports is iterable and featured_voyage.ports is not string else featured_voyage.ports }}
                    </div>
                  </td>
                </tr>
              </table>
              {% endif %}
            </td>
          </tr>
          <!-- Price + CTA row -->
          <tr>
            <td style="background-color: #0d1b2e; padding: 16px 24px;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                <tr>
                  <td style="vertical-align: middle;">
                    {% if featured_voyage.price %}
                    <div style="font-family: Georgia, serif; font-size: 10px; color: #8a9ab5;
                                letter-spacing: 2px; text-transform: uppercase; margin-bottom: 2px;">
                      Starting from
                    </div>
                    <div style="font-family: Georgia, serif; font-size: 22px; color: #e8c97a;
                                font-weight: 400; letter-spacing: 0.5px;">
                      {{ featured_voyage.price }}
                    </div>
                    <div style="font-family: Georgia, serif; font-size: 10px; color: #8a9ab5;
                                letter-spacing: 1px; text-transform: uppercase; margin-top: 1px;">
                      per person
                    </div>
                    {% endif %}
                  </td>
                  <td style="vertical-align: middle; text-align: right;">
                    <a href="mailto:concierge@d2mluxury.quest?subject=Interest: {{ featured_voyage.name | default('Featured Voyage') | urlencode }}"
                       style="display: inline-block; background-color: #c9a84c; color: #0d1b2e;
                              font-family: Georgia, serif; font-size: 11px; font-weight: 600;
                              letter-spacing: 2px; text-transform: uppercase; text-decoration: none;
                              padding: 11px 22px;">
                      Inquire Now
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
      </td>
    </tr>
    {% endif %}

    <!-- ──────────────────────────────────────────────────────────────
         LEGACY HOTEL SPOTLIGHT (only in legacy mode)
    ─────────────────────────────────────────────────────────────── -->
    {% if hotel_spotlight and bulletin is not defined %}
    <tr>
      <td style="background-color: #ffffff; padding: 36px 36px 0;">
        <div style="display: inline-block; border-bottom: 2px solid #c9a84c;
                    padding-bottom: 4px; margin-bottom: 20px;">
          <span style="font-family: Georgia, serif; font-size: 10px; color: #0d1b2e;
                       letter-spacing: 4px; text-transform: uppercase; font-weight: 600;">
            Hotel Spotlight
          </span>
        </div>
      </td>
    </tr>
    <tr>
      <td style="background-color: #ffffff; padding: 0 36px 36px;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
               style="border: 1px solid #e2e0db;">
          <!-- Hotel image (full width top) -->
          {% if hotel_spotlight.image %}
          <tr>
            <td style="padding: 0; font-size: 0; line-height: 0; overflow: hidden; position: relative;">
              <img src="{{ hotel_spotlight.image }}"
                   alt="{{ hotel_spotlight.name | default('Hotel Spotlight') }}"
                   width="528"
                   style="display: block; width: 100%; height: 200px; object-fit: cover;
                          object-position: center;">
              <!-- Our Pick badge overlay -->
              {% if hotel_spotlight.our_pick_reason %}
              <div style="position: absolute; top: 16px; right: 16px;
                          background-color: #c9a84c; color: #0d1b2e;
                          font-family: Georgia, serif; font-size: 9px; font-weight: 700;
                          letter-spacing: 2px; text-transform: uppercase; padding: 5px 12px;">
                Our Pick
              </div>
              {% endif %}
            </td>
          </tr>
          {% endif %}
          <!-- 2-col: narrative left, price box right -->
          <tr>
            <!-- Narrative -->
            <td class="stack-on-mobile"
                style="width: 65%; vertical-align: top; padding: 22px 20px 22px 22px;
                       border-right: 1px solid #e8dcc8;">
              <div style="font-family: Georgia, serif; font-size: 17px; color: #0d1b2e;
                          font-weight: 400; margin-bottom: 4px; line-height: 1.3;">
                {{ hotel_spotlight.name | default('') }}
              </div>
              {% if hotel_spotlight.location %}
              <div style="font-family: Georgia, serif; font-size: 10px; color: #8a9ab5;
                          letter-spacing: 2px; text-transform: uppercase; margin-bottom: 12px;">
                {{ hotel_spotlight.location }}
              </div>
              {% endif %}
              {% if hotel_spotlight.description %}
              <p style="font-family: Georgia, serif; font-size: 13px; color: #0000ff;
                        line-height: 1.75; margin: 0 0 12px;">
                {{ hotel_spotlight.description }}
              </p>
              {% endif %}
              {% if hotel_spotlight.our_pick_reason %}
              <div style="background-color: #f5e9c8; border-left: 3px solid #c9a84c;
                          padding: 10px 14px; margin-top: 8px;">
                <div style="font-family: Georgia, serif; font-size: 9px; color: #c9a84c;
                            letter-spacing: 2px; text-transform: uppercase; margin-bottom: 4px;
                            font-weight: 600;">
                  Why We Love It
                </div>
                <div style="font-family: Georgia, serif; font-size: 12px; color: #0d1b2e;
                            line-height: 1.6; font-style: italic;">
                  {{ hotel_spotlight.our_pick_reason }}
                </div>
              </div>
              {% endif %}
            </td>
            <!-- Price box -->
            <td class="stack-on-mobile"
                style="width: 35%; vertical-align: top; padding: 22px 18px;
                       background-color: #0d1b2e; text-align: center;">
              <div style="font-family: Georgia, serif; font-size: 10px; color: #8a9ab5;
                          letter-spacing: 2px; text-transform: uppercase; margin-bottom: 16px;">
                Nightly Rate
              </div>
              {% if hotel_spotlight.price_from %}
              <div style="font-family: Georgia, serif; font-size: 11px; color: #8a9ab5;
                          text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px;">
                From
              </div>
              <div style="font-family: Georgia, serif; font-size: 26px; color: #e8c97a;
                          font-weight: 400; line-height: 1.1; margin-bottom: 4px;">
                {{ hotel_spotlight.price_from }}
              </div>
              <div style="font-family: Georgia, serif; font-size: 9px; color: #8a9ab5;
                          letter-spacing: 1px; text-transform: uppercase; margin-bottom: 24px;">
                per night
              </div>
              {% endif %}
              <!-- Gold rule -->
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="80%" align="center"
                     style="margin: 0 auto 20px;">
                <tr><td style="height: 1px; background-color: #c9a84c; font-size: 1px;">&nbsp;</td></tr>
              </table>
              <a href="mailto:concierge@d2mluxury.quest?subject=Hotel Inquiry: {{ hotel_spotlight.name | default('') | urlencode }}"
                 style="display: inline-block; border: 1px solid #c9a84c; color: #c9a84c;
                        font-family: Georgia, serif; font-size: 10px; letter-spacing: 2px;
                        text-transform: uppercase; text-decoration: none; padding: 9px 16px;
                        margin-top: 4px;">
                Reserve
              </a>
            </td>
          </tr>
        </table>
      </td>
    </tr>
    {% endif %}

    <!-- ──────────────────────────────────────────────────────────────
         EXCURSION GEMS — 3 small cards in a row
    ─────────────────────────────────────────────────────────────── -->
    {% if excursions and excursions | length > 0 and bulletin is not defined %}
    <tr>
      <td style="background-color: #f7f3ea; padding: 36px 36px 0;">
        <div style="display: inline-block; border-bottom: 2px solid #c9a84c;
                    padding-bottom: 4px; margin-bottom: 20px;">
          <span style="font-family: Georgia, serif; font-size: 10px; color: #0d1b2e;
                       letter-spacing: 4px; text-transform: uppercase; font-weight: 600;">
            Excursion Gems
          </span>
        </div>
        <div style="font-family: Georgia, serif; font-size: 12px; color: #8a9ab5;
                    font-style: italic; margin-top: -12px; margin-bottom: 18px; margin-left: 2px;">
          Curated experiences worth building a voyage around.
        </div>
      </td>
    </tr>
    <tr>
      <td style="background-color: #f7f3ea; padding: 0 36px 36px;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
          <tr>
            {% for excursion in excursions[:3] %}
            <td class="excursion-cell"
                style="width: {{ (100 / [excursions[:3]|length, 1]|max) | int }}%;
                       vertical-align: top;
                       padding-right: {{ '12px' if not loop.last else '0' }};">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
                     style="background-color: #ffffff; border: 1px solid #e2e0db;
                            box-shadow: 0 1px 4px rgba(0,0,0,0.05);">
                {% if excursion.image %}
                <tr>
                  <td style="padding: 0; font-size: 0; line-height: 0; overflow: hidden;">
                    <img src="{{ excursion.image }}"
                         alt="{{ excursion.name | default('') }}"
                         width="160"
                         style="display: block; width: 100%; height: 120px; object-fit: cover;">
                  </td>
                </tr>
                {% else %}
                <tr>
                  <td style="background-color: #152540; height: 120px; text-align: center; padding: 20px 10px;">
                    <div style="font-family: Georgia, serif; font-size: 28px; color: #c9a84c;">
                      {{ loop.index == 1 and '&#9960;' or loop.index == 2 and '&#9973;' or '&#9968;' }}
                    </div>
                  </td>
                </tr>
                {% endif %}
                <tr>
                  <td style="padding: 14px 14px 16px;">
                    {% if excursion.destination %}
                    <div style="font-family: Georgia, serif; font-size: 9px; color: #c9a84c;
                                letter-spacing: 2px; text-transform: uppercase; margin-bottom: 5px;">
                      {{ excursion.destination }}
                    </div>
                    {% endif %}
                    <div style="font-family: Georgia, serif; font-size: 13px; color: #0d1b2e;
                                font-weight: 600; line-height: 1.35; margin-bottom: 8px;">
                      {{ excursion.name | default('') }}
                    </div>
                    {% if excursion.description %}
                    <p style="font-family: Georgia, serif; font-size: 11px; color: #0000ff;
                              line-height: 1.65; margin: 0; font-style: italic;">
                      {{ excursion.description | truncate(90) }}
                    </p>
                    {% endif %}
                  </td>
                </tr>
              </table>
            </td>
            {% endfor %}
          </tr>
        </table>
      </td>
    </tr>
    {% endif %}

    <!-- ──────────────────────────────────────────────────────────────
         INSIDER TIP — bordered intel box
    ─────────────────────────────────────────────────────────────── -->
    {% if insider_tip and bulletin is not defined %}
    <tr>
      <td style="background-color: #ffffff; padding: 36px 36px 32px;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
               style="border: 1px solid #e2e0db; border-left: 4px solid #c9a84c;
                      background-color: #fdfbf7;">
          <tr>
            <td style="padding: 22px 24px;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                <tr>
                  <td style="vertical-align: top; width: 28px; padding-right: 10px; padding-top: 2px;">
                    <!-- Compass icon approximation -->
                    <div style="width: 22px; height: 22px; background-color: #0d1b2e;
                                border-radius: 50%; text-align: center; line-height: 22px;
                                font-family: Georgia, serif; font-size: 13px; color: #c9a84c;">
                      &#9670;
                    </div>
                  </td>
                  <td style="vertical-align: top;">
                    <div style="font-family: Georgia, serif; font-size: 10px; color: #c9a84c;
                                letter-spacing: 3px; text-transform: uppercase; margin-bottom: 6px;
                                font-weight: 600;">
                      Insider Intelligence
                    </div>
                    {% if insider_tip.title %}
                    <div style="font-family: Georgia, serif; font-size: 15px; color: #0d1b2e;
                                font-weight: 400; margin-bottom: 10px; line-height: 1.35;">
                      {{ insider_tip.title }}
                    </div>
                    {% endif %}
                    {% if insider_tip.body %}
                    <p style="font-family: Georgia, serif; font-size: 13px; color: #0000ff;
                              line-height: 1.75; margin: 0;">
                      {{ insider_tip.body | replace('\n', '<br>') }}
                    </p>
                    {% endif %}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>
      </td>
    </tr>
    {% endif %}

    <!-- ──────────────────────────────────────────────────────────────
         CTA BLOCK — ready to explore?
    ─────────────────────────────────────────────────────────────── -->
    <tr>
      <td style="background-color: #0d1b2e; padding: 40px 36px; text-align: center;">
        <!-- Gold ornament -->
        <div style="font-family: Georgia, serif; font-size: 16px; color: #c9a84c;
                    letter-spacing: 8px; margin-bottom: 16px;">
          &#11835;&nbsp;&#11835;&nbsp;&#11835;
        </div>
        <div style="font-family: Georgia, serif; font-size: 22px; color: #f7f3ea;
                    font-weight: 400; margin-bottom: 10px; letter-spacing: 0.3px;">
          {{ cta_text | default('Ready to explore?') }}
        </div>
        <p style="font-family: Georgia, serif; font-size: 13px; color: #8a9ab5;
                  line-height: 1.75; margin: 0 auto 28px; max-width: 400px;">
          Reply to this email — John answers personally.
        </p>
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center">
          <tr>
            <td class="button-td button-td-primary"
                style="background-color: #c9a84c;">
              <a class="button-a button-a-primary"
                 href="mailto:concierge@d2mluxury.quest?subject={{ cta_subject | default('Let%27s Plan My Journey') }}"
                 style="background-color: #c9a84c; color: #0d1b2e; font-family: Georgia, serif;
                        font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase;
                        text-decoration: none; padding: 14px 32px; display: inline-block;">
                Start Planning
              </a>
            </td>
          </tr>
        </table>
        <!-- Divider -->
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="180" align="center"
               style="margin: 32px auto 0;">
          <tr><td style="height: 1px; background: linear-gradient(90deg, transparent, #c9a84c, transparent);
                         font-size: 1px;">&nbsp;</td></tr>
        </table>
        <div style="font-family: Georgia, serif; font-size: 11px; color: #8a9ab5;
                    margin-top: 20px; line-height: 1.65;">
          <a href="mailto:concierge@d2mluxury.quest" style="color: #c9a84c; text-decoration: none;">
            concierge@d2mluxury.quest
          </a>
          &nbsp;·&nbsp;
          <a href="https://t.me/d2m_dani_bot" style="color: #8a9ab5; text-decoration: none;">
            Telegram
          </a>
        </div>
      </td>
    </tr>

    <!-- ──────────────────────────────────────────────────────────────
         FOOTER — legal, unsubscribe, social links
    ─────────────────────────────────────────────────────────────── -->
    <tr>
      <td style="background-color: #152540; padding: 24px 36px; text-align: center;">
        <!-- Branding -->
        <div style="font-family: Georgia, serif; font-size: 12px; color: #c9a84c;
                    letter-spacing: 3px; text-transform: uppercase; margin-bottom: 6px;">
          Dreams2Memories Travel, LLC
        </div>
        <div style="font-family: Georgia, serif; font-size: 10px; color: #8a9ab5;
                    margin-bottom: 14px; letter-spacing: 0.5px;">
          Monument, Colorado
        </div>
        <!-- Gold rule -->
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="120" align="center"
               style="margin: 0 auto 14px;">
          <tr><td style="height: 1px; background-color: #1e3358; font-size: 1px;">&nbsp;</td></tr>
        </table>
        <!-- Legal credentials -->
        <div style="font-family: Georgia, serif; font-size: 9px; color: #8a9ab5;
                    letter-spacing: 1px; margin-bottom: 14px;">
          FL ST1578&nbsp;·&nbsp;CA 2090937-50&nbsp;·&nbsp;WA UBID 603189022&nbsp;·&nbsp;IA 1202
        </div>
        <!-- Unsubscribe + social -->
        <div style="font-family: Georgia, serif; font-size: 10px; color: #8a9ab5; line-height: 1.8;">
          You are receiving this because you are a valued Dreams2Memories Travel client.
          <br>
          {% if unsubscribe_url %}
          <a href="{{ unsubscribe_url }}" style="color: #8a9ab5; text-decoration: underline;">
            Unsubscribe
          </a>
          &nbsp;·&nbsp;
          {% endif %}
          <a href="mailto:concierge@d2mluxury.quest?subject=Unsubscribe" style="color: #8a9ab5; text-decoration: underline;">
            Remove me from this list
          </a>
        </div>
      </td>
    </tr>

  </table>
  <!-- /inner email wrapper -->

</td>
</tr>
</table>
<!-- /outer wrapper -->

</body>
</html>
