{
  "_comment": "Amadeus Self-Service API — free tier: 500 calls/month",
  "_signup": "https://developers.amadeus.com/register",
  "_docs": "https://developers.amadeus.com/self-service/apis-docs",
  "_setup": [
    "1. Register at developers.amadeus.com (free)",
    "2. Create a new app — get client_id + client_secret",
    "3. Copy this file to amadeus_credentials.json (remove _comment/_signup/_docs/_setup keys)",
    "4. For production: change base_url to https://api.amadeus.com"
  ],
  "client_id": "YOUR_CLIENT_ID_HERE",
  "client_secret": "YOUR_CLIENT_SECRET_HERE",
  "base_url": "https://test.api.amadeus.com"
}
